# =============================================================================
# GRC Application Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Production (DigitalOcean Managed PG): use sslmode=verify-full with the cluster
# CA certificate to prevent MITM. The CA cert content goes into DB_CA_CERT below.
#   Local:      sslmode disabled OR sslmode=require for self-hosted PG with cert
#   Production: sslmode=verify-full (cert verified via DB_CA_CERT env var)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/grc_app"

# DigitalOcean PostgreSQL CA certificate content (full PEM, including BEGIN/END lines)
# Required when DATABASE_URL uses sslmode=verify-full. Download from DO Dashboard:
#   Databases → your cluster → Connection Details → "Download CA certificate"
# Then paste the full PEM content into the env var (DO App Platform supports multi-line values).
# Leave unset for local development.
# DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# =============================================================================
# AUTHENTICATION
# =============================================================================
# NextAuth secret key - generate a random string for production
# Run: openssl rand -base64 32
AUTH_SECRET="your-secret-key-here-change-in-production"

# =============================================================================
# AI BACKEND (RunPod)
# =============================================================================
# Base URL for the AI API (RunPod endpoint)
AI_API_BASE_URL="https://your-runpod-endpoint.proxy.runpod.net/"

# API secret for authenticating with the Python AI backend
PYTHON_API_SECRET="your-python-api-secret-here"

# =============================================================================
# APP URL (for email links, notifications, redirects)
# =============================================================================
# Set this to the public URL of your app in each environment:
#   Local:  leave unset (defaults to http://localhost:3000)
#   RunPod: https://<pod-id>-3000.proxy.runpod.net
#   Vercel: https://your-app.vercel.app (or set via NEXTAUTH_URL)
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =============================================================================
# FIELD-LEVEL ENCRYPTION (Phase 2)
# =============================================================================
# Master key for AES-256-GCM encryption of sensitive DB columns (file blobs, PII).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# CRITICAL:
#   - Loss of this key = permanent loss of access to all encrypted data.
#   - Store in DO encrypted env var + offline backup (password manager).
#   - Use DIFFERENT keys for UAT and Prod (defence in depth).
#   - Rotate every 90 days using `npm run encrypt:rotate-key`.
# FIELD_ENCRYPTION_KEY="<base64-encoded 32-byte key>"

# Kill switch for field-level encryption.
# When "true": Prisma client transparently encrypts on write, decrypts on read.
# When "false" or unset: passthrough — no encryption applied to new data, no
# decryption applied to reads (existing ciphertext rows will appear as garbage).
#
# Staged rollout strategy (single-branch deploy to UAT + Prod):
#   1. Merge code with both UAT and Prod env having ENCRYPTION_ENABLED=false
#   2. Flip UAT to "true" → restart UAT app → smoke test
#   3. Run migration script against UAT DB
#   4. After 24-48h verification, flip Prod to "true"
#   5. Run migration script against Prod DB
ENCRYPTION_ENABLED="false"
