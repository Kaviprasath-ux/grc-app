# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Moat task system
.moat/

# Claude Code configuration
.claude/
.mcp.json

# VS Code
.vscode/

# Database
*.db
*.sqlite
*.sqlite3
prisma/dev.db
prisma/dev.db-journal
prisma/*.db
prisma/*.sqlite

# Prisma migrations (local database specific)
prisma/migrations/

# Temp files
tmpclaude-*
nul
backup-local-files/

# Playwright test files
.playwright-mcp/
playwright-report/
test-results/

# Debug/test scripts
check-capa.ts
check-user.ts
test-auth.ts
cookies.txt

prisma/seed-abhishek.ts

# Prisma debug/migration scripts
prisma/assign-orphaned-data.ts
prisma/check-audit-head-data.ts
prisma/check-audit-isolation.ts
prisma/create-ah-test-data.ts
prisma/debug-session-id.ts
prisma/find-deepika.ts
prisma/list-audit-heads.ts
prisma/migrate-audit-head-data.ts
prisma/migrate-settings-to-audit-heads.ts

# Debug API routes
src/app/api/debug-session/

# Uploads (root-level only — leading slash anchors to repo root so the
# pattern doesn't also swallow src/app/api/uploads/.../route.ts).
/uploads/

# Runtime-uploaded files under public/uploads (user data, not code).
# Keep the logos dir, which holds a committed brand asset.
/public/uploads/*
!/public/uploads/logos/

.env*.local
inline-validation-changes.patch

# Screenshots
*.png

# Python
__pycache__/
*.pyc

# Database backups / dumps (contain production data — never commit)
/backups/
*.dump
*.sql.gz

# Security scan output (generated artifacts)
/scan-results/

# Local-only TPRM document drafts and their generator scripts —
# kept on disk for editing but not tracked in git.
/docs/platform-docs/TPRM/
/scripts/generate-tprm-solution-design.py
/scripts/generate-tprm-sow.py
