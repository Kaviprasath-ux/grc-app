# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Moat task system
.moat/

# Claude Code configuration
.claude/

# Database
*.db
*.sqlite
*.sqlite3
prisma/dev.db
prisma/dev.db-journal
prisma/*.db
prisma/*.sqlite

# Prisma migrations (local database specific)
prisma/migrations/

# Temp files
tmpclaude-*
nul
backup-local-files/

# Playwright test files
.playwright-mcp/
playwright-report/
test-results/
