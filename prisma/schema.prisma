// ==================== REGULATORY INTELLIGENCE ====================

model RegulatoryProfile {
  id                    String          @id @default(cuid())
  customerAccountId     String
  customerAccount       CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  // Legal Identity
  fullLegalEntityName   String
  registrationNo        String
  url                   String
  country               String

  // Scope and Presence
  industrySectors       String          @db.Text // JSON array
  otherIndustry         String?
  organisationType      String
  countriesOfOperation  String          @db.Text // JSON array

  // Physical Presence
  headquarterAddress    String
  adminContactEmail     String

  // Regional Preference
  timeZone              String
  language              String

  // Business Context for AI
  businessModel         String
  targetAudience        String          @db.Text // JSON array
  technologyUsed        String          @db.Text // JSON array

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  createdBy             String?

  // Relation to suggested regulations
  suggestedRegulations  SuggestedRegulation[]

  @@index([customerAccountId])
}

// Suggested Regulations from AI (Regulatory Intelligence Hub)
model SuggestedRegulation {
  id                    String            @id @default(cuid())
  customerAccountId     String
  customerAccount       CustomerAccount   @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  regulatoryProfileId   String
  regulatoryProfile     RegulatoryProfile @relation(fields: [regulatoryProfileId], references: [id], onDelete: Cascade)

  // Regulation details from AI
  name                  String            // Regulation/Framework name
  type                  String            // "Regulatory Requirement", "Industry Standard", "Maturity Enhancing Framework"
  applicability         String            // "Mandatory", "Recommended", "Optional"
  reason                String            @db.Text // Justification from AI

  // Framework linking (for subscription)
  masterFrameworkId     String?           // Link to master framework if available
  isSubscribed          Boolean           @default(false)

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([customerAccountId])
  @@index([regulatoryProfileId])
  @@index([customerAccountId, regulatoryProfileId])
}

// ==================== DYNAMIC DATA TRANSLATIONS ====================

// DynamicTranslation stores auto-translated versions of user-entered data
// (risk names, policy descriptions, audit findings, etc.) for non-English locales.
// A single generic table — no schema changes needed per model.
model DynamicTranslation {
  id                String          @id @default(cuid())
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  modelName         String          // "Risk", "Control", "Framework", etc.
  recordId          String          // ID of the source record
  fieldName         String          // "name", "description", etc.
  locale            String          // "ar", "lv" (never "en")
  translatedText    String          @db.Text
  sourceHash        String?         // Hash of original text for staleness detection
  isStale           Boolean         @default(false)
  translatedBy      String          @default("azure") // "azure", "manual"
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([customerAccountId, modelName, recordId, fieldName, locale])
  @@index([customerAccountId, modelName, recordId])
  @@index([customerAccountId, modelName, locale])
  @@index([isStale])
}

