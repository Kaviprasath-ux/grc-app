// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== CUSTOMER ACCOUNT (MULTI-TENANT) ====================

// CustomerAccount represents a tenant in the multi-tenant system
// All business data is isolated by customerAccountId
model CustomerAccount {
  id                     String                   @id @default(cuid())
  code                   String                   @unique // e.g., GRC_001
  name                   String                   // Customer organization name
  logoUrl                String?                  // Customer logo
  isActive               Boolean                  @default(true)
  isGrcAdded             Boolean                  @default(true) // Whether this account has GRC module access (default true for legacy accounts)
  isTprmAdded            Boolean                  @default(false) // Whether this account was onboarded via TPRM
  isQpostComplianceEnabled Boolean                @default(false) // Whether this account uses QPost Compliance module
  emailNotificationsEnabled Boolean               @default(true) // Toggle for non-mandatory email notifications
  theme                    String?                  // Color theme chosen by Customer Admin (e.g., terracotta, ocean, forest, royal, slate, crimson)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  // Relations - all data belonging to this customer
  users                  User[]
  organizations          Organization[]
  departments            Department[]
  stakeholders           Stakeholder[]
  issues                 Issue[]
  services               Service[]
  frameworks             Framework[]
  requirementCategories  RequirementCategory[]
  requirements           Requirement[]
  requirementExceptions  RequirementException[]
  controls               Control[]
  processes              Process[]
  policies               Policy[]
  evidences              Evidence[]
  artifacts              Artifact[]
  exceptions             Exception[]
  kpis                   KPI[]
  assets                 Asset[]
  risks                  Risk[]
  riskControlMatrixEntries RiskControlMatrixEntry[]
  riskAssessments        RiskAssessment[]
  riskResponses          RiskResponse[]
  riskPlannedControls    RiskPlannedControl[]
  audits                 Audit[]
  auditFindings          AuditFinding[]
  capas                  CAPA[]
  internalAuditRisks     InternalAuditRisk[]
  auditableEntities      AuditableEntity[]
  auditEngagements       AuditEngagement[]
  internalAuditFindings  InternalAuditFinding[]
  internalAuditCAPAs     InternalAuditCAPA[]
  auditReports           AuditReport[]
  internalAuditDocuments InternalAuditDocument[]
  governanceVaultDocuments GovernanceVaultDocument[]
  subscriptionPlans      SubscriptionPlan[]
  // Master data relations (tenant-specific)
  regulations            Regulation[]
  controlDomains         ControlDomain[]
  assetCategories        AssetCategory[]
  assetSubCategories     AssetSubCategory[]
  assetGroups            AssetGroup[]
  ciaRatings             CIARating[]
  assetSensitivities     AssetSensitivity[]
  assetCIAClassifications AssetCIAClassification[]
  assetScoringConfigs    AssetScoringConfig[]
  assetScoringRanges     AssetScoringRange[]
  assetLifecycleStatuses AssetLifecycleStatus[]
  assetClassifications   AssetClassification[]
  riskCategories         RiskCategory[]
  riskTypes              RiskType[]
  riskThreats            RiskThreat[]
  riskVulnerabilities    RiskVulnerability[]
  riskCauses             RiskCause[]
  vulnerabilityCategories VulnerabilityCategory[]
  threatCategories       ThreatCategory[]
  controlStrengths       ControlStrength[]
  riskLikelihoods        RiskLikelihood[]
  impactCategories       ImpactCategory[]
  impactRatings          ImpactRating[]
  vulnerabilityRatings   VulnerabilityRating[]
  riskSubCategories      RiskSubCategory[]
  riskRanges             RiskRange[]
  riskScoreConfigs       RiskScoreConfig[]
  auditCategories        AuditCategory[]
  auditNatureOfControls  AuditNatureOfControl[]
  auditRiskFactors       AuditRiskFactor[]
  auditProbabilities     AuditProbability[]
  auditImpacts           AuditImpact[]
  auditScoringRanges     AuditScoringRange[]
  auditScoringConfigs    AuditScoringConfig[]
  auditPeriodicities     AuditPeriodicity[]
  auditEscalationConfigs AuditEscalationConfig[]
  auditTypes             AuditType[]
  auditLocations         AuditLocation[]
  processFrequencies     ProcessFrequency[]
  natureOfImplementations NatureOfImplementation[]
  organizationLocations  OrganizationLocation[]
  designations           Designation[]
  userDocumentTypes      UserDocumentType[]
  internalAuditProcesses InternalAuditProcess[]
  governanceTemplates    GovernanceTemplate[]
  // Notification relations
  notifications              Notification[]
  notificationPreferences    NotificationPreference[]
  // BIA Settings relations (tenant-specific)
  biaCategories              BIACategory[]
  biaRatings                 BIARating[]
  biaScoringConfigs          BIAScoringConfig[]
  biaScoringRanges           BIAScoringRange[]
  bcpLabels                  BCPLabel[]
  dynamicTranslations        DynamicTranslation[]
  regulatoryProfiles         RegulatoryProfile[]
  suggestedRegulations       SuggestedRegulation[]
  // TPRM relations
  tprmVendors                TPRMVendor[]
  tprmAssessments            TPRMAssessment[]
  tprmAssessmentLogs         TPRMAssessmentLog[]
  tprmConfiguration          TPRMConfiguration?
  tprmVendorProfileFields    TPRMVendorProfileField[]
  tprmVendorDocuments        TPRMVendorDocument[]
  tprmContractDeletionRequests TPRMContractDeletionRequest[]
  tprmOnboardingQuestions    TPRMOnboardingQuestion[]
  tprmServiceCategories      TPRMServiceCategory[]
  tprmDisciplines            TPRMDiscipline[]
  tprmDepartments            TPRMDepartment[]
  tprmQuestionnaireTemplates TPRMQuestionnaireTemplate[]
  tprmOffboardingQuestions   TPRMOffboardingQuestion[]
  tprmOffboardResponses      TPRMOffboardResponse[]
  tprmScorecardFactors       TPRMScorecardFactor[]
  tprmDomains                TPRMDomain[]
  tprmMasterQuestions        TPRMMasterQuestion[]
  tprmQuestionnaireQuestions TPRMQuestionnaireQuestion[]
  tprmMonitoringVendors      TPRMMonitoringVendor[]
  tprmMonitoringAssessments  TPRMMonitoringAssessment[]
  tprmMonitoringSchedule     TPRMMonitoringSchedule?
  tprmAssessmentResponses    TPRMAssessmentResponse[]
  tprmClarifications         TPRMClarification[]
  tprmIssueRemediations      TPRMIssueRemediation[]
  tprmVendorIssues           TPRMVendorIssue[]
  tprmInternalComments       TPRMInternalComment[]
  // QPost Compliance relations (independent module)
  qpostFrameworks            QPostFramework[]
  qpostRequirementCategories QPostRequirementCategory[]
  qpostRequirements          QPostRequirement[]
  qpostRequirementExceptions QPostRequirementException[]
  qpostPolicies              QPostPolicy[]
  qpostEvidences             QPostEvidence[]
  qpostArtifacts             QPostArtifact[]
  qpostExceptions            QPostException[]
  qpostKpis                  QPostKPI[]
  qpostGovernanceVaultDocuments QPostGovernanceVaultDocument[]
  // Chatbot relations
  chatbotAuditLogs               ChatbotAuditLog[]
}

// Subscription Plan for Customer Accounts
model SubscriptionPlan {
  id                  String          @id @default(cuid())
  customerAccountId   String
  customerAccount     CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  startDate           DateTime
  expiryDate          DateTime
  maxFrameworksAllowed Int            @default(0)
  maxAccountsAllowed   Int            @default(0)
  assessmentLimit     Int             @default(0) // TPRM: max assessments allowed
  vendorLimit         Int             @default(0) // TPRM: max vendors allowed
  frameworksUsed      Int             @default(0)
  accountsUsed        Int             @default(0)
  status              String          @default("Active") // Active, Inactive, Expired
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

// ==================== ROLE-BASED ACCESS CONTROL (RBAC) ====================

// Roles (GRCAdministrator, CustomerAdministrator, AuditHead, etc.)
model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false) // System roles cannot be deleted
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// Permissions (resource + action + scope)
model Permission {
  id        String           @id @default(cuid())
  resource  String           // e.g., "organization.process", "risk.register", "audit.dashboard"
  action    String           // e.g., "view", "create", "edit", "delete", "approve"
  scope     String           @default("all") // "all", "department", "own"
  roles     RolePermission[]
  createdAt DateTime         @default(now())

  @@unique([resource, action, scope])
}

// Role-Permission Junction Table
model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
}

// User-Role Junction Table (users can have multiple roles)
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

// ==================== ORGANIZATION MODULE ====================

// Organization Profile
model Organization {
  id                 String           @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId  String
  customerAccount    CustomerAccount  @relation(fields: [customerAccountId], references: [id])
  name               String
  email              String?
  phone              String?
  logo               String?
  establishedDate    String?
  employeeCount      Int              @default(0)
  branchCount        Int              @default(0)
  headOfficeLocation String?
  headOfficeAddress  String?
  website            String?
  description        String?
  vision             String?
  mission            String?
  value              String?
  ceoMessage         String?
  facebook           String?
  youtube            String?
  twitter            String?
  linkedin           String?
  brochure           String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  branches           Branch[]
  dataCenters        DataCenter[]
  cloudProviders     CloudProvider[]

  @@index([customerAccountId])
}

// Branch Office
model Branch {
  id             String       @id @default(cuid())
  location       String
  address        String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// Data Center
model DataCenter {
  id             String       @id @default(cuid())
  locationType   String       // On-Prem or Outsourced
  address        String?      // For On-Prem
  vendor         String?      // For Outsourced
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// Cloud Provider
model CloudProvider {
  id             String       @id @default(cuid())
  name           String
  serviceType    String       // Iaas, Paas, Saas
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// Departments
model Department {
  id                    String                 @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId     String
  customerAccount       CustomerAccount        @relation(fields: [customerAccountId], references: [id])
  name                  String
  description           String?
  headId                String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  users                 User[]
  issues                Issue[]
  stakeholders          Stakeholder[]
  controls              Control[]
  processes             Process[]
  policies              Policy[]
  assets                Asset[]
  risks                 Risk[]
  audits                Audit[]
  evidences             Evidence[]
  exceptions            Exception[]
  requirementExceptions RequirementException[]
  kpis                  KPI[]
  internalAuditRisks    InternalAuditRisk[]    @relation("InternalAuditDepartment")
  auditableEntities     AuditableEntity[]
  auditEngagements      AuditEngagement[]
  internalAuditFindings InternalAuditFinding[]
  tprmVendors           TPRMVendor[]           @relation("TPRMVendorDepartment")
  // QPost Compliance relations
  qpostPolicies              QPostPolicy[]
  qpostEvidences             QPostEvidence[]
  qpostExceptions            QPostException[]
  qpostRequirementExceptions QPostRequirementException[]
  qpostKpis                  QPostKPI[]

  @@unique([customerAccountId, name])
  @@index([customerAccountId])
}

// Users
model User {
  id                  String           @id @default(cuid())
  userId              String?
  userName            String
  email               String
  password            String?
  firstName           String
  lastName            String
  fullName            String
  designation         String?
  function            String?
  role                String           @default("User")
  language            String           @default("English")
  timezone            String           @default("UTC")
  isActive            Boolean          @default(true)
  isBlocked           Boolean          @default(false)
  // Multi-tenant: Link user to customer account
  customerAccountId   String?
  customerAccount     CustomerAccount? @relation(fields: [customerAccountId], references: [id])
  // CustomerAdmin fields (legacy - kept for backwards compatibility)
  customerCode        String?          // Customer account code (e.g., GRC_001)
  logoUrl             String?          // Customer logo URL
  lastLogin           DateTime?        // Last login timestamp
  departmentId        String?
  department          Department?      @relation(fields: [departmentId], references: [id])
  // Audit Head assignment - links auditee to their audit head
  auditHeadId         String?
  auditHead           User?            @relation("AuditHeadAuditees", fields: [auditHeadId], references: [id])
  managedAuditees     User[]           @relation("AuditHeadAuditees")
  // Reporting Manager - for organization hierarchy
  reportingManagerId  String?
  reportingManager    User?            @relation("ReportingManagerReports", fields: [reportingManagerId], references: [id])
  directReports       User[]           @relation("ReportingManagerReports")
  // Creator - tracks who created this user (for DR/DC framework visibility)
  createdById         String?
  createdBy           User?            @relation("UserCreator", fields: [createdById], references: [id])
  createdUsers        User[]           @relation("UserCreator")
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  // Relations
  ownedControls       Control[]   @relation("ControlOwner")
  assignedControls    Control[]   @relation("ControlAssignee")
  ownedRisks          Risk[]      @relation("RiskOwner")
  ownedProcesses      Process[]   @relation("ProcessOwner")
  ownedAssets         Asset[]     @relation("AssetOwner")
  custodianAssets     Asset[]     @relation("AssetCustodian")
  assignedEvidences   Evidence[]  @relation("EvidenceAssignee")
  auditor             Audit[]     @relation("Auditor")
  assignedPolicies    Policy[]    @relation("PolicyAssignee")
  approvedPolicies    Policy[]    @relation("PolicyApprover")
  requestedExceptions Exception[] @relation("ExceptionRequester")
  approverExceptions  Exception[] @relation("ExceptionApprover")
  uploadedArtifacts   Artifact[]  @relation("ArtifactUploader")
  // QPost Compliance relations
  qpostAssignedPolicies    QPostPolicy[]    @relation("QPostPolicyAssignee")
  qpostApprovedPolicies    QPostPolicy[]    @relation("QPostPolicyApprover")
  qpostPolicyManualReviews QPostPolicyManualReview[] @relation("QPostPolicyManualReviewer")
  qpostPolicyClarifications QPostPolicyClarification[] @relation("QPostPolicyClarificationUser")
  qpostEvidenceManualReviews QPostEvidenceManualReview[] @relation("QPostEvidenceManualReviewer")
  qpostEvidenceApprovals    QPostEvidence[]               @relation("QPostEvidenceApprover")
  qpostEvidenceClarifications QPostEvidenceClarification[] @relation("QPostEvidenceClarificationUser")
  qpostAssignedEvidences   QPostEvidence[]  @relation("QPostEvidenceAssignee")
  qpostUploadedArtifacts   QPostArtifact[]  @relation("QPostArtifactUploader")
  qpostRequestedExceptions QPostException[] @relation("QPostExceptionRequester")
  qpostApproverExceptions  QPostException[] @relation("QPostExceptionApprover")
  // RBAC relations
  userRoles           UserRole[]
  // Internal Audit relations
  assignedEngagements AuditEngagement[]   @relation("EngagementAuditor")
  auditeeEngagements  AuditEngagement[]   @relation("EngagementAuditee")
  memberOfEngagements AuditEngagement[]   @relation("EngagementTeamMembers")
  // Audit Head owned data
  ownedEngagements    AuditEngagement[]   @relation("AuditHeadEngagements")
  engagementComments  EngagementComment[] @relation("EngagementComments")
  ownedAuditRisks     InternalAuditRisk[] @relation("AuditHeadRisks")
  ownedAuditFindings  InternalAuditFinding[] @relation("AuditHeadFindings")
  ownedAuditCAPAs     InternalAuditCAPA[] @relation("AuditHeadCAPAs")
  ownedAuditReports   AuditReport[]       @relation("AuditHeadReports")
  ownedAuditDocuments InternalAuditDocument[] @relation("AuditHeadDocuments")
  // Audit Head owned settings (each Audit Head has their own settings)
  ownedCategories         AuditCategory[]          @relation("AuditHeadCategories")
  ownedNatureOfControls   AuditNatureOfControl[]   @relation("AuditHeadNatureOfControls")
  ownedRiskFactors        AuditRiskFactor[]        @relation("AuditHeadRiskFactors")
  ownedProbabilities      AuditProbability[]       @relation("AuditHeadProbabilities")
  ownedImpacts            AuditImpact[]            @relation("AuditHeadImpacts")
  ownedScoringRanges      AuditScoringRange[]      @relation("AuditHeadScoringRanges")
  ownedScoringConfigs     AuditScoringConfig[]     @relation("AuditHeadScoringConfigs")
  ownedPeriodicities      AuditPeriodicity[]       @relation("AuditHeadPeriodicities")
  ownedEscalationConfigs  AuditEscalationConfig[]  @relation("AuditHeadEscalationConfigs")
  ownedAuditTypes         AuditType[]              @relation("AuditHeadTypes")
  ownedLocations          AuditLocation[]          @relation("AuditHeadLocations")
  ownedProcessFrequencies ProcessFrequency[]       @relation("AuditHeadProcessFrequencies")
  ownedNatureOfImplementations NatureOfImplementation[] @relation("AuditHeadNatureOfImplementations")
  ownedInternalAuditProcesses InternalAuditProcess[] @relation("AuditHeadProcesses")
  // Process RACI relations
  responsibleProcesses Process[]          @relation("ProcessResponsible")
  accountableProcesses Process[]          @relation("ProcessAccountable")
  consultedProcesses   Process[]          @relation("ProcessConsulted")
  informedProcesses    Process[]          @relation("ProcessInformed")
  // Issue relations
  ownedIssues          Issue[]       @relation("IssueOwner")
  createdActions       IssueAction[]
  // AI relations
  aiOperations        AIOperation[]
  aiJobs              AIJob[]
  // Governance Templates
  uploadedTemplates   GovernanceTemplate[] @relation("TemplateUploader")
  uploadedPolicyAttachments PolicyAttachment[] @relation("PolicyAttachmentUploader")
  uploadedVaultDocuments    GovernanceVaultDocument[] @relation("VaultDocumentUploader")
  // Notification relations
  notifications              Notification[]
  notificationPreferences    NotificationPreference[]
  // OAuth/SSO relations
  oauthAccounts              OAuthAccount[]
  // TPRM fields
  tprmRole                   String?           // Approver, Assessor, Auditor, BusinessOwner, InternalITTeam, RelationshipManager
  tprmFunctionCategory       String?           // "TPRM Team" or "Business"
  // TPRM relations
  tprmInitiated              TPRMAssessment[]  @relation("TPRMInitiator")
  tprmAssessed               TPRMAssessment[]  @relation("TPRMAssessor")
  tprmApproved               TPRMAssessment[]  @relation("TPRMApprover")
  tprmRejected               TPRMAssessment[]  @relation("TPRMRejectedBy")
  tprmResponsesDelegated     TPRMAssessmentResponse[] @relation("TPRMResponseDelegatedTo")
  tprmResponsesResponded     TPRMAssessmentResponse[] @relation("TPRMResponseRespondedBy")
  tprmClarificationsRequested TPRMClarification[]     @relation("TPRMClarificationRequestedBy")
  tprmVendorIssuesReported   TPRMVendorIssue[]        @relation("TPRMVendorIssueReportedBy")
  tprmResponsesOverridden    TPRMAssessmentResponse[] @relation("TPRMResponseAssessorOverride")
  tprmInternalComments       TPRMInternalComment[]    @relation("TPRMInternalCommentAuthor")
  tprmRemediationComments    TPRMRemediationComment[] @relation("TPRMRemediationComments")
  tprmRemediationAssignments TPRMIssueRemediation[]  @relation("TPRMRemediationAssignee")
  tprmOffboardDelegations    TPRMOffboardResponse[]  @relation("TPRMOffboardDelegatee")
  // Chatbot relations
  chatbotAuditLogs           ChatbotAuditLog[]     @relation("ChatbotAuditLogs")
  // Contract deletion relations
  deletedDocuments           TPRMVendorDocument[]   @relation("DocumentDeletedBy")
  contractDeletionRequests   TPRMContractDeletionRequest[] @relation("DeletionRequestedBy")
  contractDeletionReviews    TPRMContractDeletionRequest[] @relation("DeletionReviewedBy")

  // Multi-tenant: userId, userName and email are unique per customer account, not globally
  @@unique([customerAccountId, userId])
  @@unique([customerAccountId, userName])
  @@unique([customerAccountId, email])
  @@index([customerAccountId])
}

// OAuth/SSO Accounts (audit trail for SSO logins)
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String   // "google" or "microsoft-entra-id"
  providerAccountId String
  email             String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Stakeholders
model Stakeholder {
  id                String             @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String
  customerAccount   CustomerAccount    @relation(fields: [customerAccountId], references: [id])
  name              String
  email             String?
  type              String             @default("Internal") // Internal, External, Third Party
  status            String             @default("Active") // Active, Inactive
  departmentId      String?
  department        Department?        @relation(fields: [departmentId], references: [id])
  issues            IssueStakeholder[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([customerAccountId])
}

// Issues
model Issue {
  id                String             @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String
  customerAccount   CustomerAccount    @relation(fields: [customerAccountId], references: [id])
  title             String
  description       String?
  domain            String // Internal, External, IT, GRC
  category          String // Finance, Human Resources, Data breach, etc.
  issueType         String? // Financial, Operational, Compliance, Security, etc.
  status            String             @default("Open") // Open, In Progress, Pending, Resolved, Closed
  dueDate           DateTime?
  departmentId      String?
  department        Department?        @relation(fields: [departmentId], references: [id])
  ownerId           String?
  owner             User?              @relation("IssueOwner", fields: [ownerId], references: [id])
  actions           IssueAction[]
  regulations       IssueRegulation[]
  processes         IssueProcess[]
  stakeholders      IssueStakeholder[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([customerAccountId])
}

// Issue Actions (created by DepartmentReviewer, reviewed by CustomerAdmin/Reviewer)
model IssueAction {
  id            String               @id @default(cuid())
  issueId       String
  issue         Issue                @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actionType    String // "Preventive", "Corrective"
  description   String
  completion    Int                  @default(0) // Completion percentage (0-100)
  comment       String?
  status        String               @default("Pending") // "Pending", "Resolved", "Sent Back"
  fileName      String?              // Original file name
  fileType      String?              // File extension/type
  filePath      String?              // Path to stored file
  fileSize      Int?                 // File size in bytes
  createdById   String
  createdBy     User                 @relation(fields: [createdById], references: [id])
  comments      IssueActionComment[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

// Comments on Issue Actions (for resend flow)
model IssueActionComment {
  id        String      @id @default(cuid())
  actionId  String
  action    IssueAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  comment   String
  createdBy String // User name or organization name
  createdAt DateTime    @default(now())
}

// Issue-Regulation Junction Table
model IssueRegulation {
  id           String     @id @default(cuid())
  issueId      String
  issue        Issue      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  regulationId String
  regulation   Regulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([issueId, regulationId])
}

// Issue-Process Junction Table
model IssueProcess {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  processId String
  process   Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([issueId, processId])
}

// Issue-Stakeholder Junction Table
model IssueStakeholder {
  id            String      @id @default(cuid())
  issueId       String
  issue         Issue       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  stakeholderId String
  stakeholder   Stakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)
  needExpectation String?   // What the stakeholder needs/expects from this issue resolution
  createdAt     DateTime    @default(now())

  @@unique([issueId, stakeholderId])
}

// Services
model Service {
  id                String          @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id])
  title             String
  description       String?
  serviceUser       String // Internal, External, Public
  serviceCategory   String?
  serviceItem       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([customerAccountId])
}

// ==================== COMPLIANCE MODULE ====================

// Frameworks
model Framework {
  id                    String                @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId     String
  customerAccount       CustomerAccount       @relation(fields: [customerAccountId], references: [id])
  code                  String?
  name                  String
  description           String?
  version               String?
  type                  String                @default("Framework") // Framework, Standard, Regulation
  status                String                @default("Subscribed") // Subscribed, Not Subscribed, Suggested, Archived
  country               String?
  industry              String?
  isCustom              Boolean               @default(false)
  // Master template flag: true = this is a master template that customers can subscribe to
  isMasterTemplate      Boolean               @default(false)
  // Source framework: links a customer's subscribed copy back to the original master
  sourceFrameworkId     String?
  sourceFramework       Framework?            @relation("FrameworkSubscriptions", fields: [sourceFrameworkId], references: [id], onDelete: SetNull)
  subscribedCopies      Framework[]           @relation("FrameworkSubscriptions")
  logo                  String?
  supportDocumentUrl    String?
  compliancePercentage  Float                 @default(0)
  policyPercentage      Float                 @default(0)
  evidencePercentage    Float                 @default(0)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  controls              Control[]
  evidences             Evidence[]
  requirements          Requirement[]
  requirementCategories RequirementCategory[]
  exceptions            Exception[]

  @@unique([customerAccountId, name])
  @@index([customerAccountId])
  @@index([sourceFrameworkId])
}

// Requirement Categories (Domains/Chapters in a framework)
model RequirementCategory {
  id                String          @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id])
  name              String
  code              String?
  description       String?
  sortOrder         Int             @default(0)
  frameworkId       String
  framework         Framework       @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  requirements      Requirement[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([frameworkId, name])
  @@index([customerAccountId])
}

// Requirements (Framework Requirements with hierarchy)
model Requirement {
  id                   String                 @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId    String
  customerAccount      CustomerAccount        @relation(fields: [customerAccountId], references: [id])
  code                 String
  name                 String
  description          String?
  requirementType      String                 @default("Mandatory") // Mandatory, Additional
  chapterType          String                 @default("Domain") // Domain, Process Domain, Technical Domain
  sortOrder            Int                    @default(0)
  level                Int                    @default(1) // Hierarchy level: 1=category, 2=requirement, 3=sub-requirement
  parentId             String?
  parent               Requirement?           @relation("RequirementHierarchy", fields: [parentId], references: [id])
  children             Requirement[]          @relation("RequirementHierarchy")
  frameworkId          String
  framework            Framework              @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  categoryId           String?
  category             RequirementCategory?   @relation(fields: [categoryId], references: [id])
  // SOA fields
  applicability        String? // Yes, No
  justification        String?
  implementationStatus String? // Yes, No, Ongoing, N/A
  controlCompliance    String? // Compliant, Non Compliant, Partial Compliant
  // Gap Assessment fields
  gapCurrentState      String?
  gapExpectedRequirement String?
  gapEvidence          String?
  gapIdentified        String?
  gapRiskLevel         String?
  gapRecommendation    String?
  gapOwner             String?
  gapTargetDate        String?
  gapStatus            String?
  gapCompliant         Boolean  @default(false)
  // Relations
  controls             RequirementControl[]
  exceptions           RequirementException[]
  complianceExceptions Exception[]
  gapPolicies          RequirementPolicy[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([frameworkId, code])
  @@index([customerAccountId])
}

// Requirement-Control Many-to-Many Junction Table
model RequirementControl {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  controlId     String
  control       Control     @relation(fields: [controlId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([requirementId, controlId])
}

// Gap Assessment - Requirement-Policy Many-to-Many Junction Table
model RequirementPolicy {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  policyId      String
  policy        Policy      @relation(fields: [policyId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([requirementId, policyId])
}

// Requirement Exceptions (for compliance exceptions from requirements)
model RequirementException {
  id                String          @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id])
  code              String
  name              String
  description       String?
  category          String          @default("Compliance") // Policy, Control, Compliance, Risk
  requirementId     String
  requirement       Requirement     @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  departmentId      String?
  department        Department?     @relation(fields: [departmentId], references: [id])
  requesterId       String?
  status            String          @default("Pending") // Pending, Approved, Authorised, Submitted for Closure, Overdue, RiskAccepted, Closed
  endDate           DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([customerAccountId, code])
  @@index([customerAccountId])
}

// Regulations (legacy - keeping for backwards compatibility)
model Regulation {
  id                     String            @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId      String?
  customerAccount        CustomerAccount?  @relation(fields: [customerAccountId], references: [id])
  name                   String
  version                String?
  sa1Date                String?
  sa2Date                String?
  scope                  String?
  exclusionJustification String?
  document               String?
  certificate            String?
  status                 String            @default("Subscribed") // Subscribed, Not Subscribed
  issues                 IssueRegulation[]
  attachments            RegulationAttachment[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@unique([customerAccountId, name])
  @@index([customerAccountId])
}

model RegulationAttachment {
  id           String     @id @default(cuid())
  regulationId String
  regulation   Regulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  type         String     // "document" or "certificate"
  fileName     String
  fileType     String?
  fileSize     Int?
  filePath     String
  uploadedAt   DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// Control Domains
model ControlDomain {
  id                String           @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String?
  customerAccount   CustomerAccount? @relation(fields: [customerAccountId], references: [id])
  code              String?
  name              String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  controls          Control[]

  @@unique([customerAccountId, name])
  @@index([customerAccountId])
}

// Controls
model Control {
  id                       String               @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId        String
  customerAccount          CustomerAccount      @relation(fields: [customerAccountId], references: [id])
  controlCode              String
  name                     String
  description              String?
  controlQuestion          String?
  functionalGrouping       String? // Govern, Identify, Protect, Detect, Respond, Recover
  status                   String               @default("Non Compliant") // Non Compliant, Compliant, Not Applicable, Partial Compliant
  entities                 String               @default("Organization Wide") // Organization Wide
  isControlList            Boolean              @default(false)
  relativeControlWeighting Int?
  scope                    String? // In-Scope, Not In-Scope
  // CMM Maturity Level Descriptions
  notPerformed             String? // CMM Level 0
  performedInformally      String? // CMM Level 1
  plannedAndTracked        String? // CMM Level 2
  wellDefined              String? // CMM Level 3
  quantitativelyControlled String? // CMM Level 4
  continuouslyImproving    String? // CMM Level 5
  // Relations
  domainId                 String?
  domain                   ControlDomain?       @relation(fields: [domainId], references: [id])
  frameworkId              String?
  framework                Framework?           @relation(fields: [frameworkId], references: [id])
  departmentId             String?
  department               Department?          @relation(fields: [departmentId], references: [id])
  ownerId                  String?
  owner                    User?                @relation("ControlOwner", fields: [ownerId], references: [id])
  assigneeId               String?
  assignee                 User?                @relation("ControlAssignee", fields: [assigneeId], references: [id])
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  evidences                Evidence[]
  exceptions               Exception[]
  requirements             RequirementControl[]
  controlRisks             ControlRisk[]
  policyControls           PolicyControl[]
  evidenceControls         EvidenceControl[]      @relation("EvidenceControls")
  // Risk Control Matrix control links
  riskControlMatrixControls RiskControlMatrixControl[]

  @@unique([customerAccountId, controlCode])
  @@index([customerAccountId])
}

// Processes
model Process {
  id                     String          @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId      String
  customerAccount        CustomerAccount @relation(fields: [customerAccountId], references: [id])
  processCode            String
  name                   String
  description            String?
  processType            String          @default("Primary") // Primary, Management, Supporting
  departmentId           String?
  department             Department?     @relation(fields: [departmentId], references: [id])
  ownerId                String?
  owner                  User?           @relation("ProcessOwner", fields: [ownerId], references: [id])
  status                 String          @default("Active")
  // Audit Library fields
  processFrequency       String?         // Annually, As needed, Bi-annually, Daily, monthly, Monthly, Quarterly, Weekly
  natureOfImplementation String?         // Manual, Automated, Manual + Automated
  riskRating             String?         // Low, Medium, High, Not Assessed
  assetDependency        Boolean         @default(false)
  assetId                String?         // Link to Asset when assetDependency is true
  asset                  Asset?          @relation("ProcessAsset", fields: [assetId], references: [id])
  externalDependency     Boolean         @default(false)
  externalParty          String?         // Name of external party when externalDependency is true
  location               String?         // JSON array of locations
  kpiMeasurementRequired Boolean         @default(false)
  // KPI Configuration fields
  kpiObjective           String?
  kpiDataSource          String?
  kpiExpectedValue       Float?
  kpiDescription         String?
  kpiFormula             String?
  kpiTargetedValue       Float?
  piiCapture             Boolean         @default(false)
  recurrence             String?         // Daily, Weekly, Monthly, Quarterly, Annually
  reviewDate             DateTime?       // Review date for KPI or PII
  operationalComplexity  String?         // Low, Medium, High
  lastAuditDate          DateTime?
  // RACI fields
  responsibleId          String?
  responsible            User?           @relation("ProcessResponsible", fields: [responsibleId], references: [id])
  accountableId          String?
  accountable            User?           @relation("ProcessAccountable", fields: [accountableId], references: [id])
  consultedId            String?
  consulted              User?           @relation("ProcessConsulted", fields: [consultedId], references: [id])
  informedId             String?
  informed               User?           @relation("ProcessInformed", fields: [informedId], references: [id])
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  // BIA Relation
  biaAssessment          ProcessBIA?
  // Issue Relation
  issues                 IssueProcess[]
  // Risks impacted by this process
  impactedByRisks        Risk[]          @relation("RiskImpactedProcess")
  // Attachments
  attachments            ProcessAttachment[]
  // Audit Engagements
  auditEngagements       AuditEngagement[]   @relation("EngagementProcess")

  @@unique([customerAccountId, processCode])
  @@index([customerAccountId])
}

// Process Attachment (files associated with processes)
model ProcessAttachment {
  id         String   @id @default(cuid())
  fileName   String
  fileType   String?  // pdf, docx, xlsx, png, jpg, etc.
  fileSize   Int?
  filePath   String
  category   String   @default("process_document") // "process_document" or "employee_onboarding"
  uploadedAt DateTime @default(now())
  processId  String
  process    Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ==================== BUSINESS IMPACT ANALYSIS (BIA) ====================

// BIA Impact Categories (Financial, Reputational, Regulatory, Safety, Operational)
model BIACategory {
  id                String          @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  sortOrder         Int             @default(0)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([customerAccountId, name])
  @@index([customerAccountId])
}

// BIA Rating Methodology (defines the rating levels and their scores)
model BIARating {
  id                String          @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  label             String          // High, Medium, Low
  score             Int             @default(0) // Score value for calculations
  description       String?         // Description of what this rating means
  color             String?         // Color code for UI display
  sortOrder         Int             @default(0)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([customerAccountId, label])
  @@index([customerAccountId])
}

// BIA Scoring Configuration (High of All, Addition of All, Product of All)
model BIAScoringConfig {
  id                String           @id @default(cuid())
  // Multi-tenant: Link to customer account (optional for backward compatibility)
  customerAccountId String?
  customerAccount   CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  calculationType   String           @default("High of all") // High of all, Addition of all, Product of all
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([customerAccountId])
}

// BIA Scoring Ranges (defines criticality levels based on scores)
model BIAScoringRange {
  id                String          @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  label             String          // Critical, High, Medium, Low
  lowValue          Int             @default(0)
  highValue         Int?
  color             String?         // Color code for UI display
  calculationType   String          @default("High of all") // Links to the scoring config
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([customerAccountId, label, calculationType])
  @@index([customerAccountId])
}

// BCP Labels (Business Continuity Planning labels for RTO/RPO)
model BCPLabel {
  id                String          @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  name              String
  type              String          // RTO, RPO
  hours             Int             @default(0) // Value in hours
  description       String?
  sortOrder         Int             @default(0)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([customerAccountId, name])
  @@index([customerAccountId])
}

// Process BIA Assessment (stores the BIA assessment for each process)
model ProcessBIA {
  id                 String              @id @default(cuid())
  processId          String              @unique
  process            Process             @relation(fields: [processId], references: [id], onDelete: Cascade)
  // BIA Status
  status             String              @default("Open") // Open, Pending Approval, Approved, Rejected
  // Calculated values
  impactRating       Int?                // Calculated based on scoring config
  processCriticality String?             // Critical, High, Medium, Low (derived from scoring ranges)
  // Recovery objectives
  rtoHours           Int                 @default(0) // Recovery Time Objective in hours
  rpoHours           Int                 @default(0) // Recovery Point Objective in hours
  rtoLabel           String?             // Label for RTO
  rpoLabel           String?             // Label for RPO
  // Scoring range values
  lowValue           Int?
  criticalValue      Int?
  highValue          Int?
  mediumValue        Int?
  // Approver
  approverId         String?
  approverName       String?
  approvedAt         DateTime?
  // Comments
  comments           String?
  rejectionReason    String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  // Category ratings
  categoryRatings    ProcessBIARating[]
  // BIA Comments (for send back flow)
  biaComments        ProcessBIAComment[]
}

// Process BIA Comments (for tracking send back comments)
model ProcessBIAComment {
  id           String     @id @default(cuid())
  processBIAId String
  processBIA   ProcessBIA @relation(fields: [processBIAId], references: [id], onDelete: Cascade)
  comment      String
  createdBy    String     // User ID
  createdByName String    // User name at time of comment
  action       String     // "SendBack", "Approve", "Submit"
  createdAt    DateTime   @default(now())
}

// Process BIA Category Ratings (individual category ratings for a process)
model ProcessBIARating {
  id            String     @id @default(cuid())
  processBIAId  String
  processBIA    ProcessBIA @relation(fields: [processBIAId], references: [id], onDelete: Cascade)
  categoryName  String     // Financial, Reputational, Regulatory, Safety, Operational
  rating        String?    // High, Medium, Low
  ratingScore   Int?       // Score value
  description   String?    // Impact description
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([processBIAId, categoryName])
}

// Governance - Policies, Standards, Procedures
model Policy {
  id                    String             @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId     String
  customerAccount       CustomerAccount    @relation(fields: [customerAccountId], references: [id])
  code                  String
  name                  String
  version               String             @default("1.0")
  documentType          String             @default("Policy") // Policy, Standard, Procedure
  recurrence            String? // Weekly, Monthly, Quarterly, Yearly
  departmentId          String?
  department            Department?        @relation(fields: [departmentId], references: [id])
  assigneeId            String?
  assignee              User?              @relation("PolicyAssignee", fields: [assigneeId], references: [id])
  approverId            String?
  approver              User?              @relation("PolicyApprover", fields: [approverId], references: [id])
  status                String             @default("Not Uploaded") // Not Uploaded, Draft, Approved, Needs Review, Published, Pending Approval
  effectiveDate         DateTime?
  reviewDate            DateTime?
  content               String?
  // AI Ingest Fields
  aiIngestStatus        String?            // NOT_STARTED, QUEUED, PROCESSING, INGESTED, FAILED
  aiIngestedAt          DateTime?
  aiIngestJobId         String?            // RunPod job ID for polling
  // AI Review Fields
  aiReviewStatus        String?            @default("Pending") // Pending, In Progress, Completed
  aiReviewScore         Float?             @default(0)
  aiReviewJustification String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  attachments           PolicyAttachment[]
  policyControls        PolicyControl[]
  policyAIReviews       PolicyAIReview[]
  policyExceptions      PolicyException[]
  exceptions            Exception[]        @relation("PolicyExceptions")
  vaultDocumentLinks    GovernanceVaultDocumentLink[]
  requirementPolicies   RequirementPolicy[]

  @@unique([customerAccountId, code])
  @@index([customerAccountId])
}

// Evidence
model Evidence {
  id                    String               @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId     String
  customerAccount       CustomerAccount      @relation(fields: [customerAccountId], references: [id])
  evidenceCode          String
  name                  String
  description           String?
  domain                String? // Compliance, Change Management, Education, Risk Management, etc.
  frameworkId           String?
  framework             Framework?           @relation(fields: [frameworkId], references: [id])
  controlId             String? // Legacy single control reference
  control               Control?             @relation(fields: [controlId], references: [id])
  departmentId          String?
  department            Department?          @relation(fields: [departmentId], references: [id])
  assigneeId            String?
  assignee              User?                @relation("EvidenceAssignee", fields: [assigneeId], references: [id])
  dueDate               DateTime?
  reviewDate            DateTime?
  recurrence            String? // Yearly, Half-yearly, Quarterly, Monthly
  status                String               @default("Not Uploaded") // Not Uploaded, Draft, Validated, Published, Need Attention
  publishedAt           DateTime?
  // KPI fields
  kpiRequired           Boolean              @default(false)
  kpiObjective          String?
  kpiDataSource         String?
  kpiExpectedScore      Float?
  kpiDescription        String?
  kpiCalculationFormula String?
  // AI status fields
  aiIngestStatus        String?              // NOT_STARTED, QUEUED, PROCESSING, INGESTED, FAILED
  aiIngestedAt          DateTime?
  aiReviewStatus        String?              // NOT_READY, IN_PROGRESS, COMPLETED, FAILED
  aiReviewedAt          DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  attachments           EvidenceAttachment[]
  kpis                  KPI[]
  evidenceControls      EvidenceControl[]
  linkedArtifacts       EvidenceArtifact[]
  evidenceAIReviews     EvidenceAIReview[]
  evidenceAIIngestJobs  EvidenceAIIngestJob[]
  evidenceAIIngestResults EvidenceAIIngestResult[]
  cycleComments          EvidenceCycleComment[]

  @@unique([customerAccountId, evidenceCode])
  @@index([customerAccountId])
}

// Evidence Cycle Comments for Send Back / Resubmit workflow
model EvidenceCycleComment {
  id          String   @id @default(cuid())
  evidenceId  String
  evidence    Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  cyclePeriod String   // e.g. "Jan-Dec", "Q1", "Jan"
  action      String   // "sendback" or "resubmit"
  comment     String
  userId      String?
  userName    String?
  createdAt   DateTime @default(now())

  @@index([evidenceId, cyclePeriod])
}

// Evidence-Control Many-to-Many Junction Table
model EvidenceControl {
  id         String   @id @default(cuid())
  evidenceId String
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  controlId  String
  control    Control  @relation("EvidenceControls", fields: [controlId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([evidenceId, controlId])
}

// Standalone Artifact for the Artifacts tab
model Artifact {
  id                String             @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String
  customerAccount   CustomerAccount    @relation(fields: [customerAccountId], references: [id])
  artifactCode      String
  name              String
  fileName          String
  fileType          String? // pdf, docx, xlsx, png, jpg, etc.
  fileSize          Int?
  filePath          String
  uploadedBy        String?
  uploadedById      String?
  uploader          User?              @relation("ArtifactUploader", fields: [uploadedById], references: [id])
  aiReviewStatus    String? // Pending, Reviewed
  aiReviewScore     Float?
  aiReviewNotes     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  linkedEvidences   EvidenceArtifact[]

  // Relation to AI reviews where this artifact was used
  evidenceAIReviews EvidenceAIReview[]

  @@unique([customerAccountId, artifactCode])
  @@index([customerAccountId])
}

// Evidence-Artifact Many-to-Many Junction Table
model EvidenceArtifact {
  id         String   @id @default(cuid())
  evidenceId String
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  artifactId String
  artifact   Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([evidenceId, artifactId])
}

// Exceptions
model Exception {
  id                String             @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String
  customerAccount   CustomerAccount    @relation(fields: [customerAccountId], references: [id])
  exceptionCode     String
  name              String
  description       String? // Reason For Exception
  category          String // Policy, Control, Compliance, Risk
  departmentId      String?
  department        Department?        @relation(fields: [departmentId], references: [id])
  // Category-specific references
  controlId         String?
  control           Control?           @relation(fields: [controlId], references: [id])
  policyId          String?
  policy            Policy?            @relation("PolicyExceptions", fields: [policyId], references: [id])
  riskId            String?
  risk              Risk?              @relation("RiskExceptions", fields: [riskId], references: [id])
  // Compliance category references
  frameworkId       String?
  framework         Framework?         @relation(fields: [frameworkId], references: [id])
  requirementId     String?
  requirement       Requirement?       @relation(fields: [requirementId], references: [id])
  // Requester and Approver
  requesterId       String?
  requester         User?              @relation("ExceptionRequester", fields: [requesterId], references: [id])
  approverId        String?
  approver          User?              @relation("ExceptionApprover", fields: [approverId], references: [id])
  // Approval details
  approvedBy        String? // Name of person who approved
  approvedDate      DateTime?
  // Status and dates
  status            String             @default("Pending") // Pending, Approved, Authorised, Submitted for Closure, Overdue, RiskAccepted, Closed
  startDate         DateTime?
  endDate           DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  // Relations
  comments          ExceptionComment[]
  policyExceptions  PolicyException[]

  @@unique([customerAccountId, exceptionCode])
  @@index([customerAccountId])
}

// Exception Comments
model ExceptionComment {
  id          String    @id @default(cuid())
  content     String
  exceptionId String
  exception   Exception @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  userId      String?
  userName    String? // Store username at time of comment
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// KPI (Key Performance Indicators)
model KPI {
  id                 String          @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId  String
  customerAccount    CustomerAccount @relation(fields: [customerAccountId], references: [id])
  code               String
  objective          String? // KPI Objective
  description        String? // KPI Description
  dataSource         String? // KPI Data Source
  calculationFormula String? // KPI Calculation Formula
  expectedScore      Float? // Expected Score
  actualScore        Float? // Current Actual Score
  reviewDate         DateTime? // Next Review Date
  status             String          @default("Scheduled") // Scheduled, Missed, Overdue, Achieved
  departmentId       String?
  department         Department?     @relation(fields: [departmentId], references: [id])
  evidenceId         String?
  evidence           Evidence?       @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  // KPI Review History
  reviews            KPIReview[]

  @@unique([customerAccountId, code])
  @@index([customerAccountId])
}

// KPI Review History (tracks actual score submissions over time)
model KPIReview {
  id           String          @id @default(cuid())
  reviewDate   DateTime
  actualScore  Float?
  status       String          @default("Scheduled") // Scheduled, Missed, Overdue, Achieved
  documentPath String? // Path to uploaded document
  documentName String? // Name of uploaded document
  kpiId        String
  kpi          KPI             @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  actionPlans  KPIActionPlan[]
}

// KPI Action Plan (for remediation when KPI is missed)
model KPIActionPlan {
  id                  String    @id @default(cuid())
  plannedAction       String // Required: The planned action to take
  description         String? // Optional: Detailed description
  percentageCompleted Float     @default(0) // Required: 0-100
  startDate           DateTime? // Required: When the action starts
  status              String    @default("In-Progress") // Open, In-Progress, Completed
  approvalStatus      String    @default("Draft") // Draft, Submitted, Approved, Sent Back
  approvalComments    String? // Comments when sent back
  kpiReviewId         String
  kpiReview           KPIReview @relation(fields: [kpiReviewId], references: [id], onDelete: Cascade)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// Policy Attachments (Governance document files)
model PolicyAttachment {
  id             String   @id @default(cuid())
  fileName       String
  fileType       String? // pdf, docx, xlsx, etc.
  fileSize       Int?
  filePath       String
  uploadedAt     DateTime @default(now())
  policyId       String
  policy         Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  uploadedById   String?
  uploadedBy     User?    @relation("PolicyAttachmentUploader", fields: [uploadedById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Governance Vault Document (Information Security Vault)
model GovernanceVaultDocument {
  id                String                        @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String
  customerAccount   CustomerAccount               @relation(fields: [customerAccountId], references: [id])
  documentCode      String                        // Auto-generated code like VD-001
  fileName          String
  fileType          String?                       // pdf, docx, xlsx, etc.
  fileSize          Int?
  filePath          String
  status            String                        @default("Active") // Active, Archived
  uploadedAt        DateTime                      @default(now())
  uploadedById      String?
  uploadedBy        User?                         @relation("VaultDocumentUploader", fields: [uploadedById], references: [id])
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  linkedPolicies    GovernanceVaultDocumentLink[]

  @@unique([customerAccountId, documentCode])
  @@index([customerAccountId])
}

// Junction table for linking vault documents to policies (many-to-many)
model GovernanceVaultDocumentLink {
  id         String                  @id @default(cuid())
  documentId String
  document   GovernanceVaultDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  policyId   String
  policy     Policy                  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  linkedAt   DateTime                @default(now())

  @@unique([documentId, policyId])
}

// Evidence Attachments (Artifacts)
model EvidenceAttachment {
  id         String   @id @default(cuid())
  fileName   String
  fileType   String? // pdf, docx, xlsx, png, jpg, etc.
  fileSize   Int?
  filePath   String
  uploadedAt DateTime @default(now())
  evidenceId String
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Policy-Control Many-to-Many Junction Table
model PolicyControl {
  id        String   @id @default(cuid())
  policyId  String
  policy    Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  controlId String
  control   Control  @relation(fields: [controlId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([policyId, controlId])
}

// Control-Risk Many-to-Many Junction Table
model ControlRisk {
  id                String           @id @default(cuid())
  controlId         String
  control           Control          @relation(fields: [controlId], references: [id], onDelete: Cascade)
  riskId            String
  risk              Risk             @relation(fields: [riskId], references: [id], onDelete: Cascade)
  controlStrengthId String?
  controlStrength   ControlStrength? @relation(fields: [controlStrengthId], references: [id])
  justification     String?
  createdAt         DateTime         @default(now())

  @@unique([controlId, riskId])
}

// Policy-Exception Many-to-Many Junction Table
model PolicyException {
  id          String    @id @default(cuid())
  policyId    String
  policy      Policy    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  exceptionId String
  exception   Exception @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([policyId, exceptionId])
}

// ==================== ASSET MANAGEMENT MODULE ====================

// Asset Category (Top-level categories: Hardware, Software, Data, etc.)
model AssetCategory {
  id                String             @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String?
  customerAccount   CustomerAccount?   @relation(fields: [customerAccountId], references: [id])
  name              String
  description       String?
  status            String             @default("Active") // Active, Inactive
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  subCategories     AssetSubCategory[]
  assets            Asset[]

  @@unique([customerAccountId, name])
  @@index([customerAccountId])
}

// Asset Sub Category (e.g., Server, Firewall under Hardware)
model AssetSubCategory {
  id                      String                   @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId       String?
  customerAccount         CustomerAccount?         @relation(fields: [customerAccountId], references: [id])
  name                    String
  description             String?
  categoryId              String
  category                AssetCategory            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  status                  String                   @default("Active") // Active, Inactive
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  assets                  Asset[]
  assetCIAClassifications AssetCIAClassification[]
  groups                  AssetGroup[]

  @@unique([customerAccountId, name, categoryId])
  @@index([customerAccountId])
}

// Asset Group (Logical groupings: Security Tools, Payment Systems, etc.)
model AssetGroup {
  id                      String                   @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId       String?
  customerAccount         CustomerAccount?         @relation(fields: [customerAccountId], references: [id])
  name                    String
  description             String?
  status                  String                   @default("Active") // Active, Inactive
  subCategoryId           String?
  subCategory             AssetSubCategory?        @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  assets                  Asset[]
  assetCIAClassifications AssetCIAClassification[]
  impactedByRisks         Risk[]                   @relation("RiskImpactedAssetGroup")

  @@unique([customerAccountId, name])
  @@index([customerAccountId])
  @@index([subCategoryId])
}

// CIA Rating Levels (for Confidentiality, Integrity, Availability)
model CIARating {
  id                String           @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String?
  customerAccount   CustomerAccount? @relation(fields: [customerAccountId], references: [id])
  type              String           // Confidentiality, Integrity, Availability
  label             String           // high, medium, low
  value             Int              // Score value (e.g., 10, 5, 1)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([customerAccountId, type, label])
  @@index([customerAccountId])
}

// Asset Sensitivity Levels
model AssetSensitivity {
  id                String                    @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String?
  customerAccount   CustomerAccount?          @relation(fields: [customerAccountId], references: [id])
  name              String                    // Public, Internal, Confidential, Restricted
  description       String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  assets            Asset[]
  classifications   AssetCIAClassification[]

  @@unique([customerAccountId, name])
  @@index([customerAccountId])
}

// Asset CIA Classification (Links Sub Category + Group with CIA ratings)
model AssetCIAClassification {
  id                    String            @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId     String?
  customerAccount       CustomerAccount?  @relation(fields: [customerAccountId], references: [id])
  subCategoryId         String
  subCategory           AssetSubCategory  @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  groupId               String
  group                 AssetGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sensitivityId         String?
  sensitivity           AssetSensitivity? @relation(fields: [sensitivityId], references: [id], onDelete: SetNull)
  confidentiality       String            @default("") // high, medium, low
  confidentialityScore  Int               @default(0)
  integrity             String            @default("") // high, medium, low
  integrityScore        Int               @default(0)
  availability          String            @default("") // high, medium, low
  availabilityScore     Int               @default(0)
  assetCriticality      String            @default("low") // high, medium, low
  assetCriticalityScore Int               @default(1)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([customerAccountId])
  @@index([sensitivityId])
}

// Asset Scoring Configuration (stores the calculation type setting)
model AssetScoringConfig {
  id                String           @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String?
  customerAccount   CustomerAccount? @relation(fields: [customerAccountId], references: [id])
  calculationType   String           @default("high_of_all") // high_of_all, addition_of_all, product_of_all
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([customerAccountId])
  @@index([customerAccountId])
}

// Asset Scoring Range (defines criticality levels based on scores for each calculation type)
model AssetScoringRange {
  id                String           @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String?
  customerAccount   CustomerAccount? @relation(fields: [customerAccountId], references: [id])
  calculationType   String           // high_of_all, addition_of_all, product_of_all
  level             String           // Critical, High, Medium, Low
  minScore          Int              @default(0)
  maxScore          Int              @default(0)
  color             String?          @default("#000000")
  sortOrder         Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([customerAccountId, calculationType, level])
  @@index([customerAccountId])
  @@index([calculationType])
}

// Asset Lifecycle Status
model AssetLifecycleStatus {
  id                String           @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String?
  customerAccount   CustomerAccount? @relation(fields: [customerAccountId], references: [id])
  name              String           // Active, In Use, Needs Maintenance, Retired
  description       String?
  order             Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  assets            Asset[]

  @@unique([customerAccountId, name])
  @@index([customerAccountId])
}

// Asset Classification (Legacy - keeping for backwards compatibility)
model AssetClassification {
  id                String           @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String?
  customerAccount   CustomerAccount? @relation(fields: [customerAccountId], references: [id])
  name              String           // Critical, High, Medium, Low
  description       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  assets            Asset[]

  @@unique([customerAccountId, name])
  @@index([customerAccountId])
}

// Assets
model Asset {
  id                String                @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String
  customerAccount   CustomerAccount       @relation(fields: [customerAccountId], references: [id])
  assetId           String
  name              String
  description       String?
  // Category hierarchy
  categoryId        String?
  category          AssetCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subCategoryId     String?
  subCategory       AssetSubCategory?     @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  groupId           String?
  group             AssetGroup?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  // Legacy asset type (keeping for backwards compatibility)
  assetType         String?               // Hardware, Software, Information, People, Services, Facility
  // Department and ownership
  departmentId      String?
  department        Department?           @relation(fields: [departmentId], references: [id])
  ownerId           String?
  owner             User?                 @relation("AssetOwner", fields: [ownerId], references: [id])
  custodianId       String?
  custodian         User?                 @relation("AssetCustodian", fields: [custodianId], references: [id])
  // Classification
  classificationId  String?
  classification    AssetClassification?  @relation(fields: [classificationId], references: [id])
  sensitivityId     String?
  sensitivity       AssetSensitivity?     @relation(fields: [sensitivityId], references: [id])
  // Lifecycle
  lifecycleStatusId String?
  lifecycleStatus   AssetLifecycleStatus? @relation(fields: [lifecycleStatusId], references: [id])
  status            String                @default("Active") // Legacy status field
  // Asset details
  value             Float?
  location          String?
  acquisitionDate   DateTime?
  nextReviewDate    DateTime?
  // Timestamps
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  // Risks impacted by this asset
  impactedByRisks   Risk[]                @relation("RiskImpactedAsset")
  // Processes that depend on this asset
  processes         Process[]             @relation("ProcessAsset")

  @@unique([customerAccountId, assetId])
  @@index([customerAccountId])
}

// ==================== RISK MANAGEMENT MODULE ====================

// Risk Categories
model RiskCategory {
  id                String           @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String?
  customerAccount   CustomerAccount? @relation(fields: [customerAccountId], references: [id])
  name              String           // Strategic, Operational, Financial, Compliance, IT/Cyber, Reputational
  description       String?
  color             String?          // Color code for UI display
  status            String           @default("Active") // Active, Inactive
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  risks             Risk[]

  @@unique([customerAccountId, name])
  @@index([customerAccountId])
}

// Risk Types
model RiskType {
  id                String           @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String?
  customerAccount   CustomerAccount? @relation(fields: [customerAccountId], references: [id])
  name              String           // Inherent, Residual, Target
  description       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  risks             Risk[]

  @@unique([customerAccountId, name])
  @@index([customerAccountId])
}

// Risk Threats
model RiskThreat {
  id                String              @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String?
  customerAccount   CustomerAccount?    @relation(fields: [customerAccountId], references: [id])
  threatId          String?
  name              String
  description       String?
  categoryId        String?
  category          ThreatCategory?     @relation(fields: [categoryId], references: [id])
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  risks             RiskThreatMapping[]

  @@unique([customerAccountId, name])
  @@unique([customerAccountId, threatId])
  @@index([customerAccountId])
}

// Risk Vulnerabilities
model RiskVulnerability {
  id                String                     @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String?
  customerAccount   CustomerAccount?           @relation(fields: [customerAccountId], references: [id])
  vulnId            String?
  name              String
  description       String?
  categoryId        String?
  category          VulnerabilityCategory?     @relation(fields: [categoryId], references: [id])
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  risks             RiskVulnerabilityMapping[]

  @@unique([customerAccountId, name])
  @@unique([customerAccountId, vulnId])
  @@index([customerAccountId])
}

// Risk Causes
model RiskCause {
  id                String             @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String?
  customerAccount   CustomerAccount?   @relation(fields: [customerAccountId], references: [id])
  name              String
  description       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  risks             RiskCauseMapping[]

  @@unique([customerAccountId, name])
  @@index([customerAccountId])
}

// Risk-Threat Mapping (many-to-many)
model RiskThreatMapping {
  id        String     @id @default(cuid())
  riskId    String
  risk      Risk       @relation(fields: [riskId], references: [id], onDelete: Cascade)
  threatId  String
  threat    RiskThreat @relation(fields: [threatId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([riskId, threatId])
}

// Risk-Vulnerability Mapping (many-to-many)
model RiskVulnerabilityMapping {
  id              String            @id @default(cuid())
  riskId          String
  risk            Risk              @relation(fields: [riskId], references: [id], onDelete: Cascade)
  vulnerabilityId String
  vulnerability   RiskVulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)
  createdAt       DateTime          @default(now())

  @@unique([riskId, vulnerabilityId])
}

// Risk-Cause Mapping (many-to-many)
model RiskCauseMapping {
  id        String    @id @default(cuid())
  riskId    String
  risk      Risk      @relation(fields: [riskId], references: [id], onDelete: Cascade)
  causeId   String
  cause     RiskCause @relation(fields: [causeId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([riskId, causeId])
}

// Risks
model Risk {
  id                  String          @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId   String
  customerAccount     CustomerAccount @relation(fields: [customerAccountId], references: [id])
  riskId              String
  name                String
  description         String?
  riskSources         String?         // Sources of the risk
  categoryId          String?
  category            RiskCategory?   @relation(fields: [categoryId], references: [id])
  typeId              String?
  type                RiskType?       @relation(fields: [typeId], references: [id])
  departmentId        String?
  department          Department?     @relation(fields: [departmentId], references: [id])
  ownerId             String?
  owner               User?           @relation("RiskOwner", fields: [ownerId], references: [id])
  // Impacted Asset Group or Process (based on Risk Type selection)
  impactedAssetId     String?
  impactedAsset       Asset?          @relation("RiskImpactedAsset", fields: [impactedAssetId], references: [id])
  impactedAssetGroupId String?
  impactedAssetGroup  AssetGroup?     @relation("RiskImpactedAssetGroup", fields: [impactedAssetGroupId], references: [id])
  impactedProcessId   String?
  impactedProcess     Process?        @relation("RiskImpactedProcess", fields: [impactedProcessId], references: [id])
  // Assessment scores
  likelihood          Int             @default(1) // 1-5 scale
  impact              Int             @default(1) // 1-5 scale
  riskScore           Int             @default(1) // likelihood * impact
  riskRating          String          @default("Low") // Catastrophic, Very High, High, Medium, Low
  // Inherent, Residual, Target risk scores
  inherentLikelihood  Int?
  inherentImpact      Int?
  inherentRiskScore   Float?
  residualLikelihood  Int?
  residualImpact      Int?
  residualRiskScore   Float?
  targetLikelihood    Int?
  targetImpact        Int?
  targetRiskScore     Int?
  // Response
  status              String          @default("Open") // Awaiting Approval, Pending Assessment, Open, In Progress, Closed
  assessmentStatus    String          @default("Open") // Open, In-Progress, Draft, Submitted, Approved, Rejected, Completed
  responseStatus      String          @default("Open") // Open, In-Progress, Awaiting Approval, Sent Back, Completed (for Risk Response Strategy)
  responseStrategy    String?         // Treat, Transfer, Avoid, Accept
  treatmentPlan       String?
  treatmentDueDate    DateTime?
  treatmentStatus     String?         // Not Started, In Progress, Completed
  // Assessment form data (JSON) - stores per-threat likelihoods, impacts, and per-vulnerability ratings
  assessmentFormData  String?         // JSON: { threatLikelihoods: {}, threatImpacts: {}, vulnerabilityRatings: {} }
  // Timestamps
  identifiedDate      DateTime        @default(now())
  lastAssessmentDate  DateTime?
  nextReviewDate      DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  // Relations
  threats             RiskThreatMapping[]
  vulnerabilities     RiskVulnerabilityMapping[]
  causes              RiskCauseMapping[]
  assessments         RiskAssessment[]
  responses           RiskResponse[]
  plannedControls     RiskPlannedControl[]
  activityLogs        RiskActivityLog[]
  controlRisks        ControlRisk[]
  exceptions          Exception[]     @relation("RiskExceptions")
  // QPost Compliance relations
  qpostExceptions     QPostException[] @relation("QPostRiskExceptions")
  // Risk Control Matrix entries (independent, deleting entry doesn't delete this risk)
  riskControlMatrixEntries RiskControlMatrixEntry[]

  @@unique([customerAccountId, riskId])
  @@index([customerAccountId])
}

// Risk Control Matrix Entry - Independent entries for Risk Control Matrix view
// Deleting these entries does NOT delete the underlying Risk
model RiskControlMatrixEntry {
  id                  String          @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId   String
  customerAccount     CustomerAccount @relation(fields: [customerAccountId], references: [id])
  // Reference to the source Risk (optional - allows matrix entry to exist even if risk is deleted)
  riskId              String?
  risk                Risk?           @relation(fields: [riskId], references: [id], onDelete: SetNull)
  // Matrix entry identifier
  matrixEntryId       String          // e.g., "RCM-001"
  // Snapshot of risk data (so matrix entry is independent)
  riskCode            String          // Copy of risk.riskId
  name                String
  description         String?
  riskRating          String?
  residualRiskRating  String?
  status              String          @default("Open")
  ownerName           String?
  // Linked controls through junction table
  linkedControls      RiskControlMatrixControl[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([customerAccountId, matrixEntryId])
  @@index([customerAccountId])
}

// Junction table for Risk Control Matrix Entry to Control
model RiskControlMatrixControl {
  id                        String                  @id @default(cuid())
  riskControlMatrixEntryId  String
  riskControlMatrixEntry    RiskControlMatrixEntry  @relation(fields: [riskControlMatrixEntryId], references: [id], onDelete: Cascade)
  controlId                 String
  control                   Control                 @relation(fields: [controlId], references: [id], onDelete: Cascade)
  createdAt                 DateTime                @default(now())

  @@unique([riskControlMatrixEntryId, controlId])
}

// Risk Assessment Records
model RiskAssessment {
  id                        String          @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId         String
  customerAccount           CustomerAccount @relation(fields: [customerAccountId], references: [id])
  assessmentId              String
  riskId                    String
  risk                      Risk            @relation(fields: [riskId], references: [id], onDelete: Cascade)
  assessmentType            String          @default("Periodic") // Initial, Periodic, Ad-hoc
  assessorName              String?
  // Assessment scores
  likelihood                Int             @default(1)
  likelihoodRationale       String?
  impact                    Int             @default(1)
  impactRationale           String?
  riskScore                 Int             @default(1)
  riskRating                String          @default("Low")
  // Identified items during assessment
  threatsIdentified         String?  // JSON array of threat names
  vulnerabilitiesIdentified String? // JSON array of vulnerability names
  causesIdentified          String?  // JSON array of cause names
  // Recommendations
  recommendations           String?
  notes                     String?
  // Status
  status                    String          @default("Draft") // Draft, Submitted, Approved, Rejected
  assessmentDate            DateTime        @default(now())
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  @@unique([customerAccountId, assessmentId])
  @@index([customerAccountId])
}

// Risk Response Records
model RiskResponse {
  id                  String          @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId   String
  customerAccount     CustomerAccount @relation(fields: [customerAccountId], references: [id])
  responseId          String
  riskId              String
  risk                Risk            @relation(fields: [riskId], references: [id], onDelete: Cascade)
  responseType        String          @default("Mitigate") // Mitigate, Transfer, Accept, Avoid
  actionTitle         String
  actionDescription   String?
  assignee            String?
