}

model QPostRequirementPolicy {
  id            String           @id @default(cuid())
  requirementId String
  requirement   QPostRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  policyId      String
  policy        QPostPolicy      @relation(fields: [policyId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())

  @@unique([requirementId, policyId])
}

model QPostPolicyManualReview {
  id            String      @id @default(cuid())
  policyId      String
  policy        QPostPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  reviewerId    String
  reviewer      User        @relation("QPostPolicyManualReviewer", fields: [reviewerId], references: [id])
  status        String      @default("Reviewed") // Reviewed, Approved, Rejected, Needs Revision
  score         Float?
  comments      String?     @db.Text
  findings      String?     @db.Text
  recommendation String?    @db.Text
  reviewDate    DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([policyId])
}

model QPostPolicyClarification {
  id        String      @id @default(cuid())
  policyId  String
  policy    QPostPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation("QPostPolicyClarificationUser", fields: [userId], references: [id])
  type      String      // "request" or "reply"
  message   String      @db.Text
  createdAt DateTime    @default(now())

  @@index([policyId])
}

model QPostEvidenceManualReview {
  id             String        @id @default(cuid())
  evidenceId     String
  evidence       QPostEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  reviewerId     String
  reviewer       User          @relation("QPostEvidenceManualReviewer", fields: [reviewerId], references: [id])
  status         String        @default("Reviewed") // Reviewed, Approved, Rejected, Needs Revision
  score          Float?
  comments       String?       @db.Text
  findings       String?       @db.Text
  recommendation String?       @db.Text
  reviewDate     DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([evidenceId])
}

model QPostEvidenceClarification {
  id        String        @id @default(cuid())
  evidenceId String
  evidence  QPostEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation("QPostEvidenceClarificationUser", fields: [userId], references: [id])
  type      String        // "request" or "reply"
  message   String        @db.Text
  createdAt DateTime      @default(now())

  @@index([evidenceId])
}

// ============================================================
// QPOST COMPLIANCE MODULE - END
// ============================================================

// ============================================================
// AI CHATBOT - KB RAG + GUARDRAILS
// ============================================================

// KB article embeddings for RAG search (pgvector)
model ChatbotKBArticle {
  id                String   @id @default(cuid())
  articleKey         String   // matches helpArticles id (e.g., "gen-login")
  module             String   // e.g., "general", "compliance", "risk-management"
  category           String
  productScope       String   // "grc", "tprm", "audit", "both"
  roles              String[] // empty = all roles, ["AuditHead"] = restricted
  question           String   @db.Text
  content            String   @db.Text // concatenated: question + answer + steps + notes
  embedding          Float[]  // 1536-dim vector from text-embedding-3-small
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([articleKey])
  @@index([module])
  @@index([productScope])
}

// Audit log for all chatbot interactions (compliance + security monitoring)
model ChatbotAuditLog {
  id                String   @id @default(cuid())
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation("ChatbotAuditLogs", fields: [userId], references: [id])
  userRole          String   // primary role at time of query
  query             String   @db.Text // original user question
  queryRedacted     String   @db.Text // PII-redacted version
  intent            String   // kb_search, data_query, general_chat
  guardrailFlags    Json?    // which guardrails triggered { inputBlocked, piiDetected, queryBlocked }
  responsePreview   String?  @db.Text // first 300 chars of response
  piiDetected       Boolean  @default(false)
  blocked           Boolean  @default(false)
  blockReason       String?
  tokensUsed        Int      @default(0)
  latencyMs         Int      @default(0)
  createdAt         DateTime @default(now())

  @@index([customerAccountId])
  @@index([userId])
  @@index([createdAt])
}

// ============================================================
// AI CHATBOT - END
// ============================================================

// ============================================================
// SYSTEM SCHEDULED TASKS
// ============================================================

model ScheduledTask {
  id            String    @id @default(cuid())
  queueId       String    @unique @default(uuid())
  name          String                           // e.g., "Cadence Reassessment"
  taskFunction  String                           // e.g., "cadence-reassessment"
  description   String?                          // Human-readable summary of what ran
  schedule      String?                          // Cron expression e.g., "0 8 * * *"
  status        String    @default("Running")    // Running, Completed, Failed
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  contextData   String?                          // JSON result: { triggered, skipped, errors }
  triggeredBy   String    @default("schedule")   // "schedule" or "manual"
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([taskFunction])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// SYSTEM SCHEDULED TASKS - END
// ============================================================
