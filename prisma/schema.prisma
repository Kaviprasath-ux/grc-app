  auditType           String?           // Internal Audit, Compliance, Financial, etc.
  auditTypeRef        AuditType?        @relation("EngagementAuditType", fields: [auditTypeId], references: [id])
  auditRating         String?           // Satisfactory, Needs Improvement, Unsatisfactory
  assignedAuditorId   String?
  assignedAuditor     User?             @relation("EngagementAuditor", fields: [assignedAuditorId], references: [id])
  auditeeId           String?
  auditee             User?             @relation("EngagementAuditee", fields: [auditeeId], references: [id])
  teamMembers         User[]            @relation("EngagementTeamMembers")
  // Planning dates
  plannedStartDate    DateTime?
  plannedEndDate      DateTime?
  actualStartDate     DateTime?
  actualEndDate       DateTime?
  startDate           DateTime?
  endDate             DateTime?
  // Hours
  plannedHours        Float             @default(0)
  actualHours         Float             @default(0)
  // Additional fields
  initialObservation  String?
  relatedPolicies     String?
  // Process relation
  processId           String?
  process             Process?          @relation("EngagementProcess", fields: [processId], references: [id])
  // Status
  status              String            @default("Planned") // Planned, In Progress, Completed, Cancelled
  priority            String            @default("Medium") // Low, Medium, High
  year                Int               @default(2026)
  quarter             String?           // Q1, Q2, Q3, Q4
  // Timestamps
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  // Relations
  fieldwork           AuditFieldwork?
  report              AuditReport?
  findings            InternalAuditFinding[]
  evidenceRequests    FieldworkEvidenceRequest[]
  linkedRisks         InternalAuditRisk[]
  aiWorkpapers        AiWorkpaper[]
  tasks               AuditEngagementTask[]
  comments            EngagementComment[]

  @@unique([customerAccountId, auditId])
  @@index([customerAccountId])
}

// Engagement Comments
model EngagementComment {
  id            String          @id @default(cuid())
  engagementId  String
  engagement    AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  userId        String
  user          User            @relation("EngagementComments", fields: [userId], references: [id])
  comment       String
  createdAt     DateTime        @default(now())

  @@index([engagementId])
}

// ==================== INTERNAL AUDIT - FIELDWORK ====================

// Audit Fieldwork (execution of audit engagement)
model AuditFieldwork {
  id              String          @id @default(cuid())
  engagementId    String          @unique
  engagement      AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  // Execution details
  startDate       DateTime?
  targetDate      DateTime?
  completionDate  DateTime?
  // Status
  status          String          @default("Not Started") // Not Started, In Progress, Review, Completed
  // Work details
  scope           String?
  objectives      String?
  methodology     String?
  observations    String?
  // Hours tracking
  hoursSpent      Float           @default(0)
  // Timestamps
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  workpapers      AuditWorkpaper[]
}

// Audit Workpapers (supporting documents for fieldwork)
model AuditWorkpaper {
  id           String         @id @default(cuid())
  fieldworkId  String
  fieldwork    AuditFieldwork @relation(fields: [fieldworkId], references: [id], onDelete: Cascade)
  fileName     String
  fileType     String?
  fileSize     Int?
  filePath     String
  description  String?
  uploadedBy   String?
  uploadedAt   DateTime       @default(now())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// AI-Generated Workpapers (structured audit tasks from AI)
model AiWorkpaper {
  id                String          @id @default(cuid())
  engagementId      String
  engagement        AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  task              String          // Task name from AI
  steps             String          // Audit steps (JSON array as string)
  evidences         String          // Evidence to collect (JSON array as string)
  questionChecklist String          // Checklist questions (JSON array as string)
  comments          String?         // Comments/notes
  executed          Boolean         @default(false) // Whether task has been executed
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([engagementId])
  @@map("AIWorkpaper")
}

// Audit Engagement Task List (manual audit tasks for fieldwork)
model AuditEngagementTask {
  id              String          @id @default(cuid())
  engagementId    String
  engagement      AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  refNo           Int             // Sequential reference number within engagement
  task            String          @default("") // Task description
  document        String?         // File path for attached document
  documentName    String?         // Original filename of attached document
  executed        Boolean         @default(false) // Whether task has been executed
  comments        String          @default("") // Task comments
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([engagementId])
}

// Fieldwork Evidence Request (requests for evidence during audit fieldwork)
model FieldworkEvidenceRequest {
  id              String                         @id @default(cuid())
  engagementId    String
  engagement      AuditEngagement                @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  sampleSize      String?
  status          String                         @default("Pending") // Pending, In Progress, Submitted, Reviewed
  aiReviewStatus  String?                        // Satisfactory, Needs Attention
  aiReviewComment String?
  dueDate         DateTime?
  category        String?                        // workpapers, other, evidence-request
  documentType    String?                        // Policy, Procedure, Evidence, Report, etc.
  // Auditee assignment (assigned by Audit Head)
  auditeeId       String?
  auditeeName     String?
  // Clarification request fields (sent by Audit Head to Auditee)
  clarificationComment      String?
  clarificationDocumentName String?
  clarificationByUserId     String?
  clarificationByUserName   String?
  clarificationSentAt       DateTime?
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt
  attachments     FieldworkEvidenceAttachment[]
}

// Fieldwork Evidence Attachment (files attached to evidence requests)
model FieldworkEvidenceAttachment {
  id                String                   @id @default(cuid())
  evidenceRequestId String
  evidenceRequest   FieldworkEvidenceRequest @relation(fields: [evidenceRequestId], references: [id], onDelete: Cascade)
  fileName          String
  fileType          String?
  fileSize          Int?
  filePath          String
  fileData          Bytes?        // Store file binary for serverless (Vercel) compatibility
  uploadedBy        String?
  uploadedAt        DateTime                 @default(now())
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
}

// ==================== INTERNAL AUDIT - REPORTS ====================

// Audit Report
model AuditReport {
  id                  String          @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId   String
  customerAccount     CustomerAccount @relation(fields: [customerAccountId], references: [id])
  // Audit Head isolation
  auditHeadId         String?
  auditHead           User?           @relation("AuditHeadReports", fields: [auditHeadId], references: [id])
  reportCode          String // Auto-generated RPT001, RPT002
  engagementId        String          @unique
  engagement          AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  // Report content
  title               String
  executiveSummary    String?
  scope               String?
  objectives          String?
  methodology         String?
  observations        String?
  recommendations     String?
  managementResponse  String?
  conclusion          String?
  // Overall Result (Pass/Fail)
  overallResult       String?         // Pass, Fail
  // Status
  status              String          @default("Draft") // Draft, Review, Final, Published
  draftGeneratedAt    DateTime?
  reviewedAt          DateTime?
  publishedAt         DateTime?
  reviewedBy          String?
  // Auditee assignment (assigned by Audit Head)
  auditeeId           String?
  auditeeName         String?
  auditeeComment      String?
  // Attachment
  reportFilePath      String?
  reportFileName      String?
  // Timestamps
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([customerAccountId, reportCode])
  @@index([customerAccountId])
}

// ==================== INTERNAL AUDIT - FINDINGS & CAPA ====================

// Internal Audit Finding (linked to engagement, separate from general AuditFinding)
model InternalAuditFinding {
  id                  String                @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId   String
  customerAccount     CustomerAccount       @relation(fields: [customerAccountId], references: [id])
  // Audit Head isolation
  auditHeadId         String?
  auditHead           User?                 @relation("AuditHeadFindings", fields: [auditHeadId], references: [id])
  findingId           String // Auto-generated FND001, FND002
  engagementId        String
  engagement          AuditEngagement       @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  // Finding details
  finding             String
  description         String?
  severity            String                @default("Medium") // Low, Medium, High, Critical
  departmentId        String?
  department          Department?           @relation(fields: [departmentId], references: [id])
  responsiblePerson   String?
  responsiblePersonId String?
  // Audit Finding Fields (Criteria, Condition, Cause, Effect)
  criteria            String?               // What should be
  condition           String?               // What is
  cause               String?               // Why it happened
  effect              String?               // The consequence
  recommendation      String?               // Recommendation
  // Dates
  identifiedDate      DateTime              @default(now())
  targetDate          DateTime?
  closedDate          DateTime?
  // Status
  status              String                @default("Open") // Open, In Progress, Closed, Overdue, Under Review
  // AI Review fields
  aiReviewStatus      String?               // "Satisfactory" | "Unsatisfactory" | null
  aiReviewDescription String?               // AI-generated description
  aiReviewedAt        DateTime?             // When AI review was completed
  aiReviewApproved    Boolean               @default(false) // Has Audit Head approved the review?
  aiApprovedAt        DateTime?             // When Audit Head approved
  aiApprovedBy        String?               // Audit Head user ID who approved
  // Timestamps
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  // Relations
  capas               InternalAuditCAPA[]
  attachments         FindingAttachment[]

  @@unique([customerAccountId, findingId])
  @@index([customerAccountId])
}

// Finding Attachment (for auditee uploads in CAPA tracking)
model FindingAttachment {
  id          String               @id @default(cuid())
  findingId   String
  finding     InternalAuditFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  fileName    String
  fileType    String?
  fileSize    Int?
  filePath    String
  uploadedBy  String?
  uploadedAt  DateTime             @default(now())
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

// Internal Audit CAPA (Corrective and Preventive Actions for internal audit findings)
model InternalAuditCAPA {
  id                String                @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String
  customerAccount   CustomerAccount       @relation(fields: [customerAccountId], references: [id])
  // Audit Head isolation
  auditHeadId       String?
  auditHead         User?                 @relation("AuditHeadCAPAs", fields: [auditHeadId], references: [id])
  capaId            String // Auto-generated CAPA001, CAPA002
  findingId         String
  finding           InternalAuditFinding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  // CAPA details
  title             String
  description       String?
  actionType        String                @default("Corrective") // Corrective, Preventive
  responsiblePerson String?
  // Dates
  targetDate        DateTime?
  completedDate     DateTime?
  // Status
  status            String                @default("Open") // Open, In Progress, Closed, Overdue
  // Evidence
  evidenceFilePath  String?
  evidenceFileName  String?
  // Timestamps
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([customerAccountId, capaId])
  @@index([customerAccountId])
}

// ==================== INTERNAL AUDIT - DOCUMENT LIBRARY ====================

// Internal Audit Document (for document library)
model InternalAuditDocument {
  id           String   @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String?
  customerAccount   CustomerAccount? @relation(fields: [customerAccountId], references: [id])
  // Audit Head isolation - documents are NOT shared between Audit Heads
  auditHeadId       String?
  auditHead         User?            @relation("AuditHeadDocuments", fields: [auditHeadId], references: [id])
  documentCode String   @unique
  name         String
  description  String?
  category     String   @default("Policy") // Policy, Regulation, PreviousReport
  fileName     String
  fileType     String?
  fileSize     Int?
  filePath     String
  fileData     Bytes?        // Store file binary for serverless (Vercel) compatibility
  uploadedBy   String?
  uploadedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // AI Ingest jobs for this document
  ingestJobs   DocumentLibraryIngestJob[]
}

// Document Library Search History
model DocumentSearch {
  id        String   @id @default(cuid())
  query     String
  result    String?  // AI response text
  status    String   @default("Satisfactory") // Satisfactory, Unsatisfactory
  userId    String?
  createdAt DateTime @default(now())
}

// Document Library AI Ingest Job - tracks async ingestion jobs for documents
model DocumentLibraryIngestJob {
  id              String    @id @default(cuid())
  documentId      String
  document        InternalAuditDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  runpodJobId     String    // RunPod job ID (multiple docs can share one job)
  customerId      String?   // customer_id sent to RunPod
  status          String    @default("queued") // queued, processing, completed, failed
  error           String?   @db.Text
  result          String?   @db.Text // JSON result
  completedAt     DateTime? // When the job completed
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@index([documentId])
  @@index([runpodJobId])
}

// ==================== GOVERNANCE TEMPLATES ====================

// Governance Templates (Policy, Standard, Procedure templates)
model GovernanceTemplate {
  id                String           @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String?
  customerAccount   CustomerAccount? @relation(fields: [customerAccountId], references: [id])
  name              String
  governanceType    String           @default("Policy") // Policy, Standard, Procedure
  fileName          String
  fileType          String?          // docx only for AI generation
  fileSize          Int?
  filePath          String
  fileData          Bytes?            // Store file content for cloud deployment
  uploadedById      String?
  uploadedBy        User?            @relation("TemplateUploader", fields: [uploadedById], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

// ==================== AUDIT LOGS ====================

model AuditLog {
  id         String   @id @default(cuid())
  changeType String // CREATE, UPDATE, DELETE
  entityType String // e.g., Control, User, Risk
  entityId   String
  userId     String?
  userName   String?
  changes    String? // JSON string of old/new values
  createdAt  DateTime @default(now())
}

// ==================== AI INFRASTRUCTURE ====================

model AIOperation {
  id                String           @id @default(cuid())
  endpoint          String
  method            String           @default("POST")
  requestBody       String?          // Store as JSON string
  responseBody      String?          // Store as JSON string
  statusCode        Int?
  latencyMs         Int?
  error             String?
  jobId             String?          // Link to AIJob if applicable
  userId            String?
  user              User?            @relation(fields: [userId], references: [id])
  evidenceAIReviews EvidenceAIReview[]
  policyAIReviews   PolicyAIReview[]
  // QPost Compliance AI relations
  qpostEvidenceAIReviews QPostEvidenceAIReview[]
  qpostPolicyAIReviews   QPostPolicyAIReview[]
  createdAt         DateTime         @default(now())

  @@index([userId])
  @@index([jobId])
}

model AIJob {
  id                String           @id @default(cuid())
  type              String           // e.g., "RISK_GENERATION", "SEMANTIC_MATCHING"
  status            String           @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  providerJobId     String?          @unique // External ID from Runpod/AI Service
  result            String?          // JSON result or reference
  error             String?
  metadata          String?          // JSON metadata
  userId            String?
  user              User?            @relation(fields: [userId], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([userId])
}

model EvidenceAIReview {
  id                String           @id @default(cuid())
  evidenceId        String
  evidence          Evidence         @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  // Explicit artifact reference for vault-query reviews
  artifactId        String?
  artifact          Artifact?        @relation(fields: [artifactId], references: [id], onDelete: SetNull)

  // Document ID tracking fields
  ingestJobId       String?          // RunPod job ID from artifact ingestion
  evidenceDocumentId   String?       // evidence.id sent as document_id during evidence ingest
  artifactDocumentId   String?       // artifact.id sent as document_id during vault-query ingest
  runpodDocumentRef    String?       // document_id returned by RunPod (if different from what we sent)

  // DEPRECATED: keep for backward compatibility, use ingestJobId instead
  documentId        String?          // External AI document ID (RunPod)

  status            String           @default("pending") // pending, completed, failed
  critique          String?          @db.Text
  complianceSummary String?          @db.Text
  complianceScore   Float?
  gaps              String?          @db.Text // JSON string
  suggestions       String?          @db.Text // JSON string
  similarityScore   Float?
  recommendations   String?          @db.Text // JSON string
  sources           String?          @db.Text // JSON array of sources from vault query
  rawResponse       String?          @db.Text // Full AI response JSON
  aiOperationId     String?
  aiOperation       AIOperation?     @relation(fields: [aiOperationId], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([evidenceId])
  @@index([artifactId])
  @@index([ingestJobId])
}

// Evidence AI Ingest Job - tracks RunPod ingest jobs
model EvidenceAIIngestJob {
  id            String    @id @default(cuid())
  evidenceId    String
  evidence      Evidence  @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  attachmentId  String?   // Optional specific attachment
  runpodJobId   String    @unique // RunPod job ID

  // Document ID tracking: what we sent vs what RunPod returned
  sentDocumentId     String?   // The document_id we sent (evidence.id or artifact.id)
  returnedDocumentId String?   // The document_id RunPod returned (if any)
  ingestedFileName   String?   // Actual file name sent to RunPod (for proper delete matching)

  status        String    @default("queued") // queued, processing, completed, failed
  error         String?   @db.Text
  result        String?   @db.Text // JSON result
  completedAt   DateTime? // When the job completed
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([evidenceId])
  @@index([runpodJobId])
  @@index([sentDocumentId])
}

// Evidence AI Ingest Result - stores extracted content from AI ingest
model EvidenceAIIngestResult {
  id              String    @id @default(cuid())
  evidenceId      String
  evidence        Evidence  @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  jobId           String    @unique // RunPod job ID reference
  extractedText   String?   @db.Text // JSON array of extracted messages
  embeddings      String?   @db.Text // Optional embeddings data
  metadata        String?   @db.Text // JSON metadata
  indexingStatus  String?   // success, failed
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@index([evidenceId])
  @@index([jobId])
}

model PolicyAIReview {
  id                String           @id @default(cuid())
  policyId          String
  policy            Policy           @relation(fields: [policyId], references: [id], onDelete: Cascade)
  documentId        String?          // External AI document ID
  status            String           @default("ingested") // ingested, completed, failed
  complianceSummary String?          @db.Text
  riskScore         Float?
  matchedControls   String?          @db.Text // JSON
  gaps              String?          @db.Text // JSON
  recommendations   String?          @db.Text // JSON
  reviewedAt        DateTime?
  aiOperationId     String?
  aiOperation       AIOperation?     @relation(fields: [aiOperationId], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([policyId])
}

// ==================== IN-APP NOTIFICATIONS ====================

// Notification Types for categorizing notifications
// Types: EVIDENCE_DUE, RISK_ASSIGNED, AUDIT_FINDING, CAPA_DUE, CONTROL_REVIEW,
//        ENGAGEMENT_ASSIGNED, APPROVAL_REQUIRED, SYSTEM, etc.

model Notification {
  id                String           @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String
  customerAccount   CustomerAccount  @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  // Recipient
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Notification content
  type              String           // e.g., EVIDENCE_DUE, RISK_ASSIGNED, AUDIT_FINDING, etc.
  title             String
  message           String           @db.Text
  // Optional link to related entity
  relatedEntityType String?          // e.g., "evidence", "risk", "audit", "capa", "control"
  relatedEntityId   String?          // ID of the related entity
  link              String?          // URL to navigate when clicked
  // Notification state
  priority          String           @default("normal") // low, normal, high, urgent
  isRead            Boolean          @default(false)
  readAt            DateTime?
  // Metadata
  metadata          String?          @db.Text // JSON for additional data
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([userId, isRead])
  @@index([customerAccountId])
  @@index([createdAt])
}

// User notification preferences
model NotificationPreference {
  id                String           @id @default(cuid())
  // Multi-tenant: Link to customer account
  customerAccountId String
  customerAccount   CustomerAccount  @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  // User
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Preference settings
  notificationType  String           // e.g., EVIDENCE_DUE, RISK_ASSIGNED, etc. or "ALL"
  inAppEnabled      Boolean          @default(true)
  emailEnabled      Boolean          @default(false)
  // Email frequency (immediate, daily_digest, weekly_digest)
  emailFrequency    String           @default("immediate")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([userId, notificationType])
  @@index([customerAccountId])
}

// ==================== EMAIL CONFIGURATION (GLOBAL - INSTANCE LEVEL) ====================
// Email settings are global for the entire application instance.
// Managed by GRCAdministrator (superadmin). All customers use the same SMTP config.

// EmailSettings - Global SMTP configuration (only ONE record should exist)
model EmailSettings {
  id                String           @id @default(cuid())
  // SMTP Configuration
  smtpHost          String           // e.g., "smtp.office365.com"
  smtpPort          Int              @default(587)
  smtpUser          String           // SMTP username/email
  smtpPassword      String           // SMTP password (should be encrypted in production)
  fromAddress       String           // e.g., "notifications@company.com"
  fromName          String?          // Display name for From field, e.g., "GRC System"
  replyToAddress    String?          // Reply-to address
  // Security settings
  useTLS            Boolean          @default(true)
  useSSL            Boolean          @default(false) // SSL on port 465
  // Status
  isActive          Boolean          @default(true)
  isVerified        Boolean          @default(false) // Set to true after successful test email
  lastTestedAt      DateTime?
  lastTestResult    String?          // Success/Error message from last test
  // Metadata
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

// EmailTemplate - Global email templates (managed by GRCAdministrator)
model EmailTemplate {
  id                String           @id @default(cuid())
  // Template identification
  code              String           @unique // Unique code, e.g., "EVIDENCE_ASSIGNED"
  name              String           // Human-readable name
  description       String?          // Description of when this template is used
  // Template content
  subject           String           // Email subject with {placeholders}
  bodyHtml          String           @db.Text // HTML body with {placeholders}
  bodyText          String?          @db.Text // Plain text alternative
  // Available placeholders (stored as JSON array)
  // e.g., ["recipientName", "entityName", "entityLink", "dueDate", "actorName"]
  placeholders      String?          @db.Text
  // Template settings
  category          String           @default("notification") // notification, reminder, system, custom
  isActive          Boolean          @default(true)
  isSystem          Boolean          @default(false) // System templates cannot be deleted
  module            String           @default("grc") // "grc" or "tprm"
  // Metadata
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([code])
  @@index([module])
}

// ==================== TPRM (Third-Party Risk Management) ====================

// TPRMVendor — Third-party vendors managed for risk assessment
model TPRMVendor {
  id                  String          @id @default(cuid())
  customerAccountId   String
  customerAccount     CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  vendorCode          String          // e.g., VEN001
  name                String
  contactEmail        String?
  contactPhone        String?
  accountManagerName  String?
  accountManagerEmail String?
  serviceCategory     String?         // e.g., "IT Services", "Cloud Infrastructure"
  departmentId        String?
  department          Department?     @relation("TPRMVendorDepartment", fields: [departmentId], references: [id])
  status              String          @default("Onboarding") // Onboarding, Onboarded, Offboarding, Offboarded
  engagementId        String?         // External engagement identifier
  vrr                 String?         // Vendor Risk Rating: Critical, High, Moderate, Low, Nominal
  serviceDescription  String?         @db.Text
  contractStartDate   DateTime?
  contractEndDate     DateTime?
  accessToNetwork     Boolean         @default(false)
  cloud               Boolean         @default(false)
  accessToData        Boolean         @default(false)
  pii                 Boolean         @default(false)
  businessJustification String?       @db.Text
  vendorCertification String?
  vendorUrl           String?
  password            String?
  onboardedDate       DateTime?
  offboardedDate      DateTime?
  contractDocumentName String?
  contractDocumentPath String?
  onboardingAnswers   String?         @db.Text // JSON: { questionId: answer } for onboarding question responses
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  assessments         TPRMAssessment[]
  monitoringVendor    TPRMMonitoringVendor? @relation("MonitoringToVendor")
  vendorIssues        TPRMVendorIssue[]
  vendorDocuments     TPRMVendorDocument[]
  contractDeletionRequests TPRMContractDeletionRequest[]

  @@unique([customerAccountId, vendorCode])
  @@index([customerAccountId])
  @@index([customerAccountId, status])
}

// TPRMVendorDocument — Documents attached to a vendor (legal, report, general)
model TPRMVendorDocument {
  id                String      @id @default(cuid())
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  vendorId          String
  vendor            TPRMVendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  docType           String      @default("document") // "legal", "report", "document", "contract"
  fileName          String
  filePath          String
  isDeleted         Boolean     @default(false)
  deletedAt         DateTime?
  deletedBy         String?
  deletedByUser     User?       @relation("DocumentDeletedBy", fields: [deletedBy], references: [id])
  deletionReason    String?
  createdAt         DateTime    @default(now())
  deletionRequests  TPRMContractDeletionRequest[]

  @@index([customerAccountId, vendorId])
}

// TPRMContractDeletionRequest — RM/BO requests superadmin to delete a vendor contract
model TPRMContractDeletionRequest {
  id                String      @id @default(cuid())
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  documentId        String
  document          TPRMVendorDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  vendorId          String
  vendor            TPRMVendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  reason            String
  status            String      @default("Pending") // Pending, Approved, Rejected
  requestedBy       String
  requestedByUser   User        @relation("DeletionRequestedBy", fields: [requestedBy], references: [id])
  requestedAt       DateTime    @default(now())
  reviewedBy        String?
  reviewedByUser    User?       @relation("DeletionReviewedBy", fields: [reviewedBy], references: [id])
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime    @default(now())

  @@index([customerAccountId])
  @@index([status])
}

// TPRMAssessment — Vendor risk assessments
model TPRMAssessment {
  id                    String          @id @default(cuid())
  customerAccountId     String
  customerAccount       CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  assessmentCode        String          // e.g., ASM001
  vendorId              String
  vendor                TPRMVendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  assessmentType        String          // "Assessment Factory", "Onboarding Assessment", "Periodic Assessment", "On-Demand Assessment"
  status                String          @default("Draft") // Approved, Initiated, In_Progress, Awaiting_Response, Completed, In_Progress_approver_, Offboard_In_Progress, Offboard_Completed, Offboard_Awaiting_Respose, Offboard_Approve_Assessor, Offboard_Approve_RM, Offboard_Approve_BO
  assessmentResult      String?         // Satisfactory, Unsatisfactory, Deficient
  vendorSubmissionDate  DateTime?
  assessorCompletionDate DateTime?
  approvalDate          DateTime?
  completionDate        DateTime?
  initiatedById         String?
  initiatedBy           User?           @relation("TPRMInitiator", fields: [initiatedById], references: [id])
  assessorId            String?
  assessor              User?           @relation("TPRMAssessor", fields: [assessorId], references: [id])
  approverId            String?
  approver              User?           @relation("TPRMApprover", fields: [approverId], references: [id])
  questionnaireTemplate String?         // Template name used for assessment
  dueDate               DateTime?       // Assessment due date for reminders
  approverComment       String?
  rejectedById          String?
  rejectedBy            User?           @relation("TPRMRejectedBy", fields: [rejectedById], references: [id])
  // AI Evaluation tracking
  aiEvaluationStatus    String?         // Pending, Ingesting, Evaluating, Completed, Failed
  aiEvaluationStarted   DateTime?
  aiEvaluationCompleted DateTime?
  aiEvaluationError     String?         @db.Text
  cadenceReassessmentTriggered Boolean  @default(false) // Set true once a cadence-based reassessment has been auto-created
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  logs                  TPRMAssessmentLog[]
  responses             TPRMAssessmentResponse[]
  offboardResponses     TPRMOffboardResponse[]
  clarifications        TPRMClarification[]
  issueRemediations     TPRMIssueRemediation[]
  internalComments      TPRMInternalComment[]

  @@unique([customerAccountId, assessmentCode])
  @@index([customerAccountId])
  @@index([customerAccountId, assessmentType])
  @@index([customerAccountId, status])
}

// TPRMAssessmentLog — Audit logs for assessment activities
model TPRMAssessmentLog {
  id                String          @id @default(cuid())
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  assessmentId      String
  assessment        TPRMAssessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  domainName        String?
  questionNo        String?
  questionTitle     String?
  logDate           DateTime        @default(now())
  logMessage        String?
  apiUrl            String?
  documentName      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([customerAccountId])
  @@index([assessmentId])
}

// TPRMConfiguration — Single flat record per customer with all DD + Scorecard values
model TPRMConfiguration {
  id                String          @id @default(cuid())
  customerAccountId String          @unique
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  // DueDiligence — VRR thresholds per risk category
  vrrCritical       Int             @default(50)
  vrrHigh           Int             @default(40)
  vrrModerate       Int             @default(30)
  vrrLow            Int             @default(20)
  vrrNominal        Int             @default(0)

  // DueDiligence — Assessment cadence (months)
  cadenceCritical   Int             @default(1)
  cadenceHigh       Int             @default(3)
  cadenceModerate   Int             @default(6)
  cadenceLow        Int             @default(24)
  cadenceNominal    Int             @default(36)

  // DueDiligence — Remediation period (days)
  remediationCritical Int           @default(7)
  remediationHigh     Int           @default(14)
  remediationModerate Int           @default(30)
  remediationLow      Int           @default(60)
  remediationNominal  Int           @default(90)

  // DueDiligence — Reminder before due date (days)
  reminderCritical  Int             @default(5)
  reminderHigh      Int             @default(5)
  reminderModerate  Int             @default(5)
  reminderLow       Int             @default(5)
  reminderNominal   Int             @default(5)

  // DueDiligence — Due date period (days)
  dueDateCritical   Int             @default(30)
  dueDateHigh       Int             @default(30)
  dueDateModerate   Int             @default(30)
  dueDateLow        Int             @default(30)
  dueDateNominal    Int             @default(30)

  // Scorecard — Security score per rating
  scorecardExcellent Int            @default(5)
  scorecardGood      Int            @default(4)
  scorecardModerate  Int            @default(3)
  scorecardLow       Int            @default(2)
  scorecardNominal   Int            @default(0)

  // Scorecard Configuration — formula & weights
  scoringFormula          String    @default("AVG")  // "AVG" or "SUM"
  securityPostureWeight   Int       @default(50)     // percentage
  threatExposureWeight    Int       @default(50)     // percentage

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([customerAccountId])
}

// TPRMVendorProfileField — Vendor onboarding profile fields configuration
model TPRMVendorProfileField {
  id                String          @id @default(cuid())
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  fieldName         String
  isSystem          Boolean         @default(false) // System fields cannot be edited/deleted
  isActive          Boolean         @default(true)
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([customerAccountId, fieldName])
  @@index([customerAccountId])
}

// TPRMOnboardingQuestion — Vendor onboarding questionnaire
model TPRMOnboardingQuestion {
  id                String          @id @default(cuid())
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  title             String
  question          String?         @db.Text
  score             Int             @default(0)
  questionType      String          @default("Parent") // "Parent" or "Child"
  parentId          String?
  parent            TPRMOnboardingQuestion?  @relation("OnboardingQuestionHierarchy", fields: [parentId], references: [id])
  children          TPRMOnboardingQuestion[] @relation("OnboardingQuestionHierarchy")
  responseType      String          @default("Yes/No") // "Yes/No" or "FreeText"
  isActive          Boolean         @default(true)
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([customerAccountId])
  @@index([parentId])
}

// TPRMServiceCategory — Service categories for vendor classification
model TPRMServiceCategory {
  id                String          @id @default(cuid())
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  name              String
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([customerAccountId, name])
  @@index([customerAccountId])
}

// TPRMDiscipline — Disciplines for vendor assessment (e.g., Compliance, Cyber)
model TPRMDiscipline {
  id                String          @id @default(cuid())
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  name              String
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([customerAccountId, name])
  @@index([customerAccountId])
}

// TPRMDepartment — TPRM-specific departments (separate from GRC departments)
model TPRMDepartment {
  id                String          @id @default(cuid())
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  name              String
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([customerAccountId, name])
  @@index([customerAccountId])
}

// TPRMQuestionnaireTemplate — Assessment questionnaire templates
model TPRMQuestionnaireTemplate {
  id                String          @id @default(cuid())
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  templateName      String
  frameworkName     String?
  templateCategory  String          @default("Default") // "Default", "ISMS", "Compliance"
  imageUrl          String?
  vendorProfileQuestionIds String?  @db.Text  // JSON array of onboarding question IDs
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  masterQuestionLinks TPRMQuestionnaireQuestion[]

  @@unique([customerAccountId, templateName])
  @@index([customerAccountId])
}

// TPRMOffboardingQuestion — Vendor offboarding questionnaire
model TPRMOffboardingQuestion {
  id                String          @id @default(cuid())
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  sequenceNo        Int
  title             String
  question          String?         @db.Text
  isActive          Boolean         @default(true)
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([customerAccountId])
}

// TPRMOffboardResponse — Per-question responses for vendor offboarding assessment
model TPRMOffboardResponse {
  id                String          @id @default(cuid())
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  assessmentId      String
  assessment        TPRMAssessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId        String          // TPRMOffboardingQuestion.id
  questionNo        Int             // sequenceNo snapshot
  questionTitle     String          // question title snapshot
  questionText      String?         @db.Text // question text snapshot
  response          String?         // "Yes", "No", "NA"
  comment           String?         @db.Text
  artifactUrl       String?
  artifactName      String?
  isFlagged         Boolean         @default(false)
  isDelegated       Boolean         @default(false)
  delegatedToId     String?
  delegatedTo       User?           @relation("TPRMOffboardDelegatee", fields: [delegatedToId], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([assessmentId, questionId])
  @@index([customerAccountId])
  @@index([assessmentId])
}

// TPRMScorecardFactor — Security scorecard factors (SecurityPosture & ThreatExposure)
model TPRMScorecardFactor {
  id                String          @id @default(cuid())
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  factorId          String          // e.g., "network_security", "known_breach"
  name              String          // Display name
  weightage         Int             @default(0) // percentage
  isMandatory       Boolean         @default(true)
  scoreType         String          // "SecurityPosture" or "ThreatExposure"
  isSystem          Boolean         @default(false) // System factors cannot be deleted
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([customerAccountId, factorId])
  @@index([customerAccountId])
  @@index([customerAccountId, scoreType])
}

// TPRMDomain — Assessment domain categories (e.g., Information Security, Privacy)
model TPRMDomain {
  id                String          @id @default(cuid())
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  isActive          Boolean         @default(true)
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  questions         TPRMMasterQuestion[]

  @@unique([customerAccountId, name])
  @@index([customerAccountId])
}

// TPRMMasterQuestion — Master question bank entries linked to domains
model TPRMMasterQuestion {
  id                  String          @id @default(cuid())
  customerAccountId   String
  customerAccount     CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  domainId            String?
  domain              TPRMDomain?     @relation(fields: [domainId], references: [id], onDelete: SetNull)
  questionText        String          @db.Text
  verifaiPrompt       String?         @db.Text
  sortOrder           Int             @default(0)
  isActive            Boolean         @default(true)
  // Parent-child hierarchy
  isParentQuestion    Boolean         @default(true)
  parentId            String?
  parent              TPRMMasterQuestion?  @relation("QuestionParent", fields: [parentId], references: [id], onDelete: SetNull)
  children            TPRMMasterQuestion[] @relation("QuestionParent")
  // Assessment metadata
  mandatoryAttachment Boolean         @default(false)
  validateThroughAI   Boolean         @default(false)
  mandatoryQuestion   Boolean         @default(false)
  evidence            String?
  issue               String?
  risk                String?
  recommendation      String?
  severity            String?         // High, Medium, Low
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  questionnaireLinks  TPRMQuestionnaireQuestion[]

  @@index([customerAccountId])
  @@index([customerAccountId, domainId])
}

// TPRMQuestionnaireQuestion — Junction linking master questions to questionnaire templates
model TPRMQuestionnaireQuestion {
  id                String                    @id @default(cuid())
  customerAccountId String
  customerAccount   CustomerAccount           @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  templateId        String
  template          TPRMQuestionnaireTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  questionId        String
  question          TPRMMasterQuestion        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sortOrder         Int                       @default(0)
  createdAt         DateTime                  @default(now())

  @@unique([templateId, questionId])
  @@index([customerAccountId])
}

// ==================== TPRM MONITORING ====================

model TPRMMonitoringVendor {
  id                String    @id @default(cuid())
  customerAccountId String
  vendorName        String
  vendorURL         String
  vendorOnboarded   Boolean   @default(false)
  tprmVendorId      String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  customerAccount   CustomerAccount            @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  assessments       TPRMMonitoringAssessment[]
  tprmVendor        TPRMVendor?                @relation("MonitoringToVendor", fields: [tprmVendorId], references: [id], onDelete: SetNull)

  @@index([customerAccountId])
}

model TPRMMonitoringAssessment {
  id                        String    @id @default(cuid())
  customerAccountId         String
  monitoringVendorId        String
  vendorName                String
  vendorURL                 String
  jobID                     String?
  status                    String?
  overallSummary            String?   @db.Text
  overallScore              Int?
  securityPostureScore      Int?
  threatExposureScore       Int?
  securityPostureSummary    String?   @db.Text
  threatExposureSummary     String?   @db.Text
  lastScan                  DateTime?
  nextScan                  String?
  isLatest                  Boolean   @default(true)
  downloadType              String?
  calculatedSecurityPosture Float?
  calculatedThreatExposure  Float?
  calculatedOverallScore    Float?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  customerAccount   CustomerAccount             @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  monitoringVendor  TPRMMonitoringVendor        @relation(fields: [monitoringVendorId], references: [id], onDelete: Cascade)
  complianceAndLegal TPRMComplianceAndLegal?
  recommendation    TPRMMonitoringRecommendation?
  kpiDetails        TPRMKPIDetail[]
  httpHeaders       TPRMHTTPHeader[]

  @@index([customerAccountId])
  @@index([monitoringVendorId])
}

model TPRMComplianceAndLegal {
  id               String    @id @default(cuid())
  assessmentId     String    @unique
  privacyPolicyUrl String?
  dpaUrl           String?
  createdAt        DateTime  @default(now())

  assessment       TPRMMonitoringAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  laws             TPRMLaw[]
  certifications   TPRMCertification[]
}

model TPRMLaw {
  id           String                 @id @default(cuid())
  complianceId String
  lawName      String
  createdAt    DateTime               @default(now())

  compliance   TPRMComplianceAndLegal @relation(fields: [complianceId], references: [id], onDelete: Cascade)
}

model TPRMCertification {
  id           String                 @id @default(cuid())
  complianceId String
  name         String
  createdAt    DateTime               @default(now())

  compliance   TPRMComplianceAndLegal @relation(fields: [complianceId], references: [id], onDelete: Cascade)
}

model TPRMMonitoringRecommendation {
  id           String    @id @default(cuid())
  assessmentId String    @unique
  statement    String    @db.Text
  createdAt    DateTime  @default(now())

  assessment   TPRMMonitoringAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

model TPRMKPIDetail {
  id                String    @id @default(cuid())
  assessmentId      String
  kpiName           String
  kpiType           String?
  securityScore     Int?
  summary           String?   @db.Text
  riskScore         Int?
  recommendation    String?   @db.Text
  cveId             String?
  severity          String?
  description       String?   @db.Text
  affectedComponent String?
  createdAt         DateTime  @default(now())

  assessment        TPRMMonitoringAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  keyFindings       TPRMKeyFinding[]
  sources           TPRMSource[]
  vulnerabilities   TPRMVulnerabilityFinding[]

  @@index([assessmentId])
}

model TPRMKeyFinding {
  id          String        @id @default(cuid())
  kpiDetailId String
  statement   String        @db.Text
  createdAt   DateTime      @default(now())

  kpiDetail   TPRMKPIDetail @relation(fields: [kpiDetailId], references: [id], onDelete: Cascade)
}

model TPRMSource {
  id          String        @id @default(cuid())
  kpiDetailId String
  name        String
  createdAt   DateTime      @default(now())

  kpiDetail   TPRMKPIDetail @relation(fields: [kpiDetailId], references: [id], onDelete: Cascade)
}

model TPRMVulnerabilityFinding {
  id                String        @id @default(cuid())
  kpiDetailId       String
  cveId             String?
  severity          String?
  affectedComponent String?
  description       String?       @db.Text
  createdAt         DateTime      @default(now())

  kpiDetail         TPRMKPIDetail @relation(fields: [kpiDetailId], references: [id], onDelete: Cascade)

  @@index([kpiDetailId])
}

model TPRMHTTPHeader {
  id             String    @id @default(cuid())
  assessmentId   String
  name           String
  present        Boolean   @default(false)
  value          String?
  recommendation String?   @db.Text
  description    String?   @db.Text
  createdAt      DateTime  @default(now())

  assessment     TPRMMonitoringAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  platforms      TPRMPlatform[]

  @@index([assessmentId])
}

model TPRMPlatform {
  id           String          @id @default(cuid())
  httpHeaderId String
  server       String
  createdAt    DateTime        @default(now())

  httpHeader   TPRMHTTPHeader  @relation(fields: [httpHeaderId], references: [id], onDelete: Cascade)
}

model TPRMMonitoringSchedule {
  id                String   @id @default(uuid())
  customerAccountId String   @unique
  recurrence        String   @default("none") // none, daily, weekly, monthly, custom
  customDays        Int?                       // only used when recurrence = "custom"
  lastScheduledRun  DateTime?
  nextScheduledRun  DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
}

// TPRMAssessmentResponse — Per-question answers from Account Manager
model TPRMAssessmentResponse {
  id                String          @id @default(cuid())
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  assessmentId      String
  assessment        TPRMAssessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId        String
  domainId          String?
  questionNo        String?
  response          String?         // "Yes", "No", "NA"
  comment           String?         @db.Text
  artifactUrl       String?
  artifactName      String?
  isFlagged         Boolean         @default(false)
  isDelegated       Boolean         @default(false)
  delegatedToId     String?
  delegatedTo       User?           @relation("TPRMResponseDelegatedTo", fields: [delegatedToId], references: [id])
  respondedById     String?
  respondedBy       User?           @relation("TPRMResponseRespondedBy", fields: [respondedById], references: [id])
  respondedAt       DateTime?
  // AI Evaluation results
  poScore           Float?
  poStatus          String?         // Satisfactory, Unsatisfactory, Not_Applicable, Failed
  poAnswer          String?         @db.Text
  poIssue           String?         @db.Text
  poRisk            String?         @db.Text
  poRecommendation  String?         @db.Text
  poSeverity        String?
  aiUuid            String?         // uuid from api/query response
  aiEvaluatedAt     DateTime?
  // Assessor override fields
  assessorStatus        String?         // Satisfactory, Unsatisfactory, Not_Applicable (assessor override)
  assessorIssue         String?         @db.Text
  assessorRisk          String?         @db.Text
  assessorRecommendation String?       @db.Text
  assessorComment       String?         @db.Text
  assessorSeverity      String?         // Low, Medium, High
  assessorOverriddenAt  DateTime?
  assessorOverriddenById String?
  assessorOverriddenBy  User?           @relation("TPRMResponseAssessorOverride", fields: [assessorOverriddenById], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([assessmentId, questionId])
  @@index([customerAccountId])
  @@index([assessmentId])
}

// TPRMClarification — Assessor requests clarification on a question
model TPRMClarification {
  id                String          @id @default(cuid())
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  assessmentId      String
  assessment        TPRMAssessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionNo        String?
  domainName        String?
  rejectComment     String?         @db.Text
  amResponse        String?         @db.Text
  status            String          @default("Pending") // Pending, Submitted, Closed
  requestedById     String?
  requestedBy       User?           @relation("TPRMClarificationRequestedBy", fields: [requestedById], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([customerAccountId])
  @@index([assessmentId])
}

// TPRMIssueRemediation — Issue remediation requests for Account Manager
model TPRMIssueRemediation {
  id                String          @id @default(cuid())
  issueCode         String?         // e.g., ISS-001, ISS-002
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  assessmentId      String
  assessment        TPRMAssessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionNo        String?
  questionText      String?         @db.Text
  questionResponse  String?         // Original AM answer: Yes, No, NA
  domainName        String?
  severity          String?         // Critical, High, Medium, Low
  description       String?         @db.Text
  issue             String?         @db.Text
  risk              String?         @db.Text
  recommendation    String?         @db.Text
  amResponse        String?         @db.Text
  amComment         String?         @db.Text
  assessorComment   String?         @db.Text    // Assessor comment when marking unsatisfied
  artifactUrl       String?
  artifactName      String?
  itArtifactUrl     String?              // Artifacts uploaded by IT Team (separate from AM artifacts)
  itArtifactName    String?
  requestedDate     DateTime?
  dueDate           DateTime?
  responseDate      DateTime?
  returnedAt        DateTime?                    // Set when assessor sends back as unsatisfied
  reassignComment   String?         @db.Text     // Assessor comment when sending to business/RM
  assignedToUserId  String?                      // RM user assigned for remediation
  assignedToUser    User?           @relation("TPRMRemediationAssignee", fields: [assignedToUserId], references: [id])
  assignedAt        DateTime?                    // When the issue was assigned to RM
  status            String          @default("Pending") // Pending, Submitted, Closed, Assigned to BO, Assigned to IT
  comments          TPRMRemediationComment[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([customerAccountId])
  @@index([assessmentId])
  @@index([assignedToUserId])
}

// TPRMRemediationComment — Chat-style comments on issue remediations
model TPRMRemediationComment {
  id              String              @id @default(cuid())
  remediationId   String
  remediation     TPRMIssueRemediation @relation(fields: [remediationId], references: [id], onDelete: Cascade)
  userId          String
  user            User                @relation("TPRMRemediationComments", fields: [userId], references: [id])
  userRole        String?             // e.g., "Account Manager", "Assessor", "Approver"
  message         String              @db.Text
  createdAt       DateTime            @default(now())

  @@index([remediationId])
}

// TPRMInternalComment — Internal assessor comments on assessment questions
model TPRMInternalComment {
  id                String          @id @default(cuid())
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  assessmentId      String
  assessment        TPRMAssessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId        String?
  message           String          @db.Text
  authorId          String
  author            User            @relation("TPRMInternalCommentAuthor", fields: [authorId], references: [id])
  createdAt         DateTime        @default(now())

  @@index([customerAccountId])
  @@index([assessmentId])
}

// TPRMVendorIssue — Vendor-reported issues by Account Manager
model TPRMVendorIssue {
  id                String          @id @default(cuid())
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  vendorId          String
  vendor            TPRMVendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  title             String
  description       String?         @db.Text
  severity          String?         // Critical, High, Medium, Low
  dueDate           DateTime?
  resolution        String?         @db.Text
  status            String          @default("Open") // Open, Submitted, Closed
  reportedById      String?
  reportedBy        User?           @relation("TPRMVendorIssueReportedBy", fields: [reportedById], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([customerAccountId])
